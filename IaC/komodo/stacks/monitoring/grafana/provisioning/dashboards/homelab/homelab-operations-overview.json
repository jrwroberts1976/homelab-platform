    {
      "id": 18,
      "type": "table",
      "title": "Node Exporter Health by Host",
      "description": "Only configured Prometheus targets appear here; compare against the canonical estate inventory to identify missing monitoring coverage.",
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"node-exporter\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "target_name": "Host",
              "Value": "Exporter Up"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No telemetry",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
