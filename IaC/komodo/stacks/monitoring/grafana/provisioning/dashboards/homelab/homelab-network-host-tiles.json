    {
      "id": 7,
      "type": "text",
      "title": "Device identity and evidence",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**One tile per MAC address** (IP fallback until a MAC is known). Select a tile to open that device's native Grafana profile. **Documented OS** = canonical inventory; **DNS/Nmap OS** = inference only. **Ports** = observed open ports from limited scans; a missing result or timed-out scan is not proof that ports are closed. DNS hints are a dated 18–25 September 2026 snapshot, not continuous DNS telemetry."
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "All network devices — click a tile for its host dashboard",
      "description": "One status tile per known device; Grafana creates tiles directly from MAC-keyed Prometheus series.",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_card_online{device_key=~\"$device\"}",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{hostname}} | {{ip}} | {{os}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": -1,
          "max": 1,
          "decimals": 0,
          "links": [
            {
              "title": "Dedicated MAC-linked host dashboard",
              "url": "/d/${__field.labels.dashboard_uid}/host",
              "targetBlank": false
            },
            {
              "title": "Generic device profile",
              "url": "/d/homelab-mac-device-detail/homelab-mac-device-detail?var-device=${__field.labels.device_key}",
              "targetBlank": false
            }
          ],
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                },
                "-1": {
                  "text": "UNKNOWN",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "gray",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": false
      }
    },
    {
      "id": 9,
      "title": "All hosts — OS identity, source, MAC and observed ports",
      "type": "table",
      "description": "Each row represents one device; no data about open ports means no positive evidence, not no open ports.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_card_info{device_key=~\"$device\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "target_name": true
            },
            "indexByName": {
              "hostname": 0,
              "ip": 1,
              "mac": 2,
              "status": 3,
              "os": 4,
              "os_evidence": 5,
              "os_source": 6,
              "observed_open_ports": 7,
              "vendor": 8,
              "role": 9,
              "device_key": 10
            },
            "renameByName": {
              "hostname": "Hostname",
              "ip": "IP",
              "mac": "MAC",
              "status": "Status",
              "os": "Operating system",
              "os_evidence": "OS evidence",
              "os_source": "OS source",
              "observed_open_ports": "Observed open ports",
              "vendor": "Vendor",
              "role": "Role",
              "device_key": "Device ID"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true
      }
    },
