{
  "id": null,
  "uid": "homelab-router-device-profile",
  "title": "Homelab \u2014 Router Device Profile",
  "description": "MAC-keyed device identity. Scan evidence is displayed separately only when a profile is available.",
  "tags": [
    "homelab",
    "network",
    "device",
    "mac"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "2m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "mac",
        "label": "Device MAC Address",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values({__name__=~\"homelab_router_device_info|homelab_lan_presence_info\"}, mac)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "All Router Devices",
      "type": "link",
      "url": "/d/homelab-router-devices",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Device Identity and Network Adapter Manufacturer",
      "description": "MAC-keyed DHCP identity. The OUI manufacturer identifies the network adapter, not necessarily the complete device. The IP address is the last recorded DHCP address.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(homelab_router_device_info{mac=\"$mac\"} * on(mac) group_left(vendor) homelab_router_device_adapter_vendor_info{mac=\"$mac\"}) or (homelab_router_device_info{mac=\"$mac\"} unless on(mac) homelab_router_device_adapter_vendor_info{mac=\"$mac\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last DHCP Observation",
      "description": "The last recorded DHCP observation; this is not proof that the device is currently online.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_router_device_last_dhcp_seen_seconds{mac=\"$mac\"} * 1000",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "No DHCP timestamp"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Available Scan Report",
      "description": "A report is available only after a completed or partial profiling scan.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_router_device_scan_state{mac=\"$mac\",status=~\"complete|partial\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mac"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open Nmap scan report",
                    "url": "/d/homelab-router-device-scan?var-mac=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LAN Sweep \u2014 Online Status",
      "description": "Latest MAC observation, not proof of reachability.",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_lan_presence_observed{mac=\"$mac\"} and on() (time() - homelab_lan_presence_last_sweep_seconds < 1200)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No recent sweep data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Not observed",
                  "color": "orange"
                },
                "1": {
                  "text": "Observed",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "LAN Sweep \u2014 Last Seen",
      "description": "Last actual MAC observation, retained across missed sweeps.",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_lan_presence_last_seen_seconds{mac=\"$mac\"} * 1000",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "Not yet observed"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "LAN Sweep \u2014 Device Identity",
      "description": "MAC, last known IP and verified hostname where available.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(max by(mac,ip)(homelab_lan_presence_info{mac=\"$mac\"}) * on(mac) group_left(hostname) label_replace(max by(mac,exported_target_name)(homelab_lan_presence_host_info),\"hostname\",\"$1\",\"exported_target_name\",\"(.+)\")) or (max by(mac,ip)(homelab_lan_presence_info{mac=\"$mac\"}) unless on(mac) label_replace(max by(mac,exported_target_name)(homelab_lan_presence_host_info),\"hostname\",\"$1\",\"exported_target_name\",\"(.+)\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
