# Zabbix runtime secret contract.
#
# Do not store a populated copy in Git.
#
# Recommended runtime location:
#   /home/james/.config/homelab/secrets/zabbix-server.env
#
# Load before deployment with:
#   set -a
#   . /home/james/.config/homelab/secrets/zabbix-server.env
#   set +a

HOMELAB_ZABBIX_DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_SECRET
