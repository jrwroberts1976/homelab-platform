// Managed by Ansible. Do not edit manually.

loki.relabel "journal" {
  forward_to = [loki.process.journal_hygiene.receiver]

  rule {
    target_label = "job"
    replacement  = "{{ alloy_journal_job }}"
  }
}

loki.source.journal "system" {
  forward_to = [loki.relabel.journal.receiver]

  labels = {
    hostname    = "{{ alloy_host_label }}",
    host        = "{{ alloy_host_label }}",
    role        = "{{ alloy_host_role }}",
    environment = "{{ alloy_environment }}",
    source      = "{{ alloy_journal_source }}",
  }
}

loki.process "journal_hygiene" {
  forward_to = [loki.write.homelab.receiver]

  // Ansible module invocation records can contain raw command arguments.
  // Journal MESSAGE differs by host: some retain the ansible-ansible.*
  // prefix while others expose only the wrapper payload. Match both forms.
  stage.drop {
    expression          = "^(ansible-ansible\\..* )?Invoked with _raw_params="
    drop_counter_reason = "ansible_module_invocation"
  }

  // Debian 13/OpenSSH may emit this exact benign legacy-accounting warning
  // when /run/utmp is absent while wtmpdb handles SSH accounting.
  stage.drop {
    expression          = "^syslogin_perform_logout: logout\\(\\) returned an error$"
    drop_counter_reason = "debian_openssh_logout_noise"
  }
}

{% if alloy_docker_logs_enabled | bool %}
//
// Docker container logging
//
// Docker metadata is discovered from the local daemon. Only hosts with
// alloy_docker_logs_enabled=true receive this pipeline.
//
discovery.docker "containers" {
  host = "{{ alloy_docker_host }}"
}

discovery.relabel "docker_logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = [
      "__meta_docker_container_label_com_docker_compose_service",
    ]
    target_label = "service"
  }
}

loki.source.docker "containers" {
  host    = "{{ alloy_docker_host }}"
  targets = discovery.docker.containers.targets

  labels = {
    job         = "docker",
    hostname    = "{{ alloy_host_label }}",
    host        = "{{ alloy_host_label }}",
    role        = "{{ alloy_host_role }}",
    environment = "{{ alloy_environment }}",
    source      = "docker",
  }

  relabel_rules = discovery.relabel.docker_logs.rules
  forward_to    = [loki.write.homelab.receiver]
}

{% endif %}
{% if alloy_pihole_logs_enabled | bool %}
// Pi-hole privacy boundary: only fixed event names may leave this host.
// Do not forward raw query lines or attach client/domain labels.
local.file_match "pihole" {
  path_targets = [{
    __path__    = "{{ alloy_pihole_log_path }}",
    job         = "pihole",
    hostname    = "{{ alloy_host_label }}",
    host        = "{{ alloy_host_label }}",
    role        = "{{ alloy_host_role }}",
    environment = "{{ alloy_environment }}",
    source      = "pihole-event",
  }]
}

loki.source.file "pihole" {
  targets    = local.file_match.pihole.targets
  forward_to = [loki.process.pihole_event_only.receiver]
}

loki.process "pihole_event_only" {
  forward_to = [loki.write.homelab.receiver]

  // Fail closed: discard any line not matching the allowlisted event types.
  // Match only the event token and its expected following structural field.
  stage.match {
    selector = "{job=\"pihole\"} |!~ \" (query\\[[A-Za-z0-9]+\\] .* from |gravity blocked .* is |regex blocked .* is |exactly blocked .* is |forwarded .* to |reply .* is )\""
    action   = "drop"
  }

  // Replace the entire line with a bounded event token before Loki export.
  stage.regex {
    expression = "^.* (?P<event>query\\[[A-Za-z0-9]+\\]|gravity blocked|regex blocked|exactly blocked|forwarded|reply) .*$"
  }
  stage.output {
    source = "event"
  }
}
{% endif %}

loki.write "homelab" {
  endpoint {
    url = "{{ alloy_loki_endpoint }}"
  }
}
