#!/usr/bin/env python3

import json
import os
import sqlite3
import subprocess
import tempfile
import time
from pathlib import Path

ROUTER = "{{ asus_network_inventory_router }}"
ROUTER_USER = "{{ asus_network_inventory_router_user }}"
SSH_KEY = "{{ asus_network_inventory_ssh_key }}"
KNOWN_HOSTS = "{{ asus_network_inventory_known_hosts }}"

DATABASE = Path("{{ asus_network_inventory_database }}")
METRICS_FILE = Path("{{ asus_network_inventory_metrics_file }}")

NOW = int(time.time())


def router(command):
    result = subprocess.run(
        [
            "ssh",
            "-i", SSH_KEY,
            "-o", "IdentitiesOnly=yes",
            "-o", "BatchMode=yes",
            "-o", "StrictHostKeyChecking=yes",
            "-o", "UserKnownHostsFile=" + KNOWN_HOSTS,
            ROUTER_USER + "@" + ROUTER,
            command,
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    )

    return result.stdout


def parse_dhcp(text):
    leases = {}

    for line in text.splitlines():
        fields = line.split()

        if len(fields) < 4:
            continue

        try:
            expiry = int(fields[0])
        except ValueError:
            continue

        mac = fields[1].lower()
        ip = fields[2]
        hostname = fields[3]

        if hostname == "*":
            hostname = ""

        leases[ip] = {
            "ip": ip,
            "mac": mac,
            "dhcp_hostname": hostname,
            "dhcp_lease_expiry": expiry,
        }

    return leases


def parse_arp(text):
    hosts = {}

    for line in text.splitlines():
        fields = line.split()

        if len(fields) < 6:
            continue

        if fields[0] == "IP":
            continue

        ip = fields[0]
        flags = fields[2]
        mac = fields[3].lower()
        interface = fields[5]

        if not ip.startswith("192.168.2."):
            continue

        if mac == "00:00:00:00:00:00":
            mac = ""

        hosts[ip] = {
            "ip": ip,
            "mac": mac,
            "arp_flags": flags,
            "arp_interface": interface,
        }

    return hosts


def connect():
    DATABASE.parent.mkdir(parents=True, exist_ok=True)

    db = sqlite3.connect(DATABASE)
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA busy_timeout=5000")

    db.execute(
        """
        CREATE TABLE IF NOT EXISTS assets (
            ip TEXT PRIMARY KEY,
            mac TEXT,
            hostname TEXT,
            dhcp_hostname TEXT,
            dhcp_lease_expiry INTEGER,
            arp_flags TEXT,
            arp_interface TEXT,
            first_seen INTEGER NOT NULL,
            last_seen INTEGER NOT NULL,
            last_dhcp_seen INTEGER,
            last_arp_seen INTEGER,
            online INTEGER NOT NULL DEFAULT 0
        )
        """
    )

    db.execute(
        """
        CREATE TABLE IF NOT EXISTS asset_events (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp INTEGER NOT NULL,
            ip TEXT NOT NULL,
            event TEXT NOT NULL,
            source TEXT NOT NULL,
            details TEXT
        )
        """
    )

    return db


def record_event(db, ip, event_name, source, details=None):
    db.execute(
        """
        INSERT INTO asset_events
            (timestamp, ip, event, source, details)
        VALUES (?, ?, ?, ?, ?)
        """,
        (
            NOW,
            ip,
            event_name,
            source,
            json.dumps(details, sort_keys=True)
            if details is not None
            else None,
        ),
    )


def escape_label(value):
    return (
        str(value or "")
        .replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", " ")
    )


def write_metrics(db):
    metrics = [
        "# HELP asus_network_asset_info ASUS network asset identity information.",
        "# TYPE asus_network_asset_info gauge",
        "# HELP asus_network_asset_up Whether the ASUS router currently reports the asset.",
        "# TYPE asus_network_asset_up gauge",
        "# HELP asus_network_asset_dhcp Whether the asset has a current DHCP lease.",
        "# TYPE asus_network_asset_dhcp gauge",
        "# HELP asus_network_asset_arp Whether the asset appears in the ASUS ARP table.",
        "# TYPE asus_network_asset_arp gauge",
        "# HELP asus_network_asset_last_seen_seconds Unix timestamp of the last ASUS observation.",
        "# TYPE asus_network_asset_last_seen_seconds gauge",
        "# HELP asus_network_asset_inventory_total Number of assets retained in the ASUS inventory.",
        "# TYPE asus_network_asset_inventory_total gauge",
    ]

    rows = db.execute(
        """
        SELECT
            ip,
            mac,
            hostname,
            last_dhcp_seen,
            last_arp_seen,
            last_seen,
            online
        FROM assets
        ORDER BY ip
        """
    ).fetchall()

    for (
        ip,
        mac,
        hostname,
        last_dhcp_seen,
        last_arp_seen,
        last_seen,
        online,
    ) in rows:

        ip_label = escape_label(ip)
        mac_label = escape_label(mac)
        hostname_label = escape_label(hostname)

        info_labels = (
            'ip="' + ip_label + '",'
            'mac="' + mac_label + '",'
            'hostname="' + hostname_label + '"'
        )

        metrics.append(
            "asus_network_asset_info{" + info_labels + "} 1"
        )

        metrics.append(
            'asus_network_asset_up{ip="' + ip_label + '"} '
            + str(1 if online else 0)
        )

        metrics.append(
            'asus_network_asset_dhcp{ip="' + ip_label + '"} '
            + str(1 if last_dhcp_seen else 0)
        )

        metrics.append(
            'asus_network_asset_arp{ip="' + ip_label + '"} '
            + str(1 if last_arp_seen else 0)
        )

        metrics.append(
            'asus_network_asset_last_seen_seconds{ip="'
            + ip_label
            + '"} '
            + str(last_seen)
        )

    metrics.append(
        "asus_network_asset_inventory_total " + str(len(rows))
    )

    METRICS_FILE.parent.mkdir(parents=True, exist_ok=True)

    fd, tmp = tempfile.mkstemp(
        dir=str(METRICS_FILE.parent),
        prefix="." + METRICS_FILE.name + ".",
    )

    try:
        with os.fdopen(fd, "w") as fh:
            fh.write("\n".join(metrics) + "\n")
            fh.flush()
            os.fsync(fh.fileno())

        os.chmod(tmp, 0o644)
        os.replace(tmp, METRICS_FILE)

    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def main():
    dhcp_text = router("cat /var/lib/misc/dnsmasq.leases")
    arp_text = router("cat /proc/net/arp")

    dhcp = parse_dhcp(dhcp_text)
    arp = parse_arp(arp_text)

    db = connect()

    all_ips = set(dhcp) | set(arp)

    for ip in sorted(all_ips):
        dhcp_entry = dhcp.get(ip, {})
        arp_entry = arp.get(ip, {})

        mac = (
            dhcp_entry.get("mac")
            or arp_entry.get("mac")
            or ""
        )

        hostname = dhcp_entry.get("dhcp_hostname", "")

        row = db.execute(
            """
            SELECT
                mac,
                hostname,
                dhcp_hostname,
                online
            FROM assets
            WHERE ip = ?
            """,
            (ip,),
        ).fetchone()

        if row is None:
            db.execute(
                """
                INSERT INTO assets (
                    ip,
                    mac,
                    hostname,
                    dhcp_hostname,
                    dhcp_lease_expiry,
                    arp_flags,
                    arp_interface,
                    first_seen,
                    last_seen,
                    last_dhcp_seen,
                    last_arp_seen,
                    online
                )
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """,
                (
                    ip,
                    mac,
                    hostname,
                    hostname,
                    dhcp_entry.get("dhcp_lease_expiry"),
                    arp_entry.get("arp_flags", ""),
                    arp_entry.get("arp_interface", ""),
                    NOW,
                    NOW,
                    NOW if ip in dhcp else None,
                    NOW if ip in arp else None,
                    1,
                ),
            )

            record_event(
                db,
                ip,
                "asset_discovered",
                "asus",
                {
                    "mac": mac,
                    "dhcp": ip in dhcp,
                    "arp": ip in arp,
                },
            )

            continue

        old_mac, old_hostname, old_dhcp_hostname, old_online = row

        if not old_online:
            record_event(
                db,
                ip,
                "asset_online",
                "asus",
                {
                    "dhcp": ip in dhcp,
                    "arp": ip in arp,
                },
            )

        if mac and old_mac and old_mac != mac:
            record_event(
                db,
                ip,
                "mac_changed",
                "asus",
                {
                    "old": old_mac,
                    "new": mac,
                },
            )

        if hostname and old_hostname != hostname:
            record_event(
                db,
                ip,
                "hostname_changed",
                "asus",
                {
                    "old": old_hostname,
                    "new": hostname,
                },
            )

        db.execute(
            """
            UPDATE assets
            SET
                mac = ?,
                hostname = ?,
                dhcp_hostname = ?,
                dhcp_lease_expiry = ?,
                arp_flags = ?,
                arp_interface = ?,
                last_seen = ?,
                last_dhcp_seen = CASE
                    WHEN ? THEN ?
                    ELSE last_dhcp_seen
                END,
                last_arp_seen = CASE
                    WHEN ? THEN ?
                    ELSE last_arp_seen
                END,
                online = 1
            WHERE ip = ?
            """,
            (
                mac or old_mac,
                hostname or old_hostname,
                hostname or old_dhcp_hostname,
                dhcp_entry.get("dhcp_lease_expiry"),
                arp_entry.get("arp_flags", ""),
                arp_entry.get("arp_interface", ""),
                NOW,
                ip in dhcp,
                NOW,
                ip in arp,
                NOW,
                ip,
            ),
        )

    offline_cutoff = (
        NOW - {{ asus_network_inventory_offline_grace_seconds }}
    )

    missing_ips = {
        row[0]
        for row in db.execute(
            """
            SELECT ip
            FROM assets
            WHERE online = 1
              AND last_seen <= ?
            """,
            (offline_cutoff,),
        ).fetchall()
        if row[0] not in all_ips
    }

    for ip in sorted(missing_ips):
        db.execute(
            """
            UPDATE assets
            SET online = 0
            WHERE ip = ?
            """,
            (ip,),
        )

        record_event(
            db,
            ip,
            "asset_offline",
            "asus",
            {
                "last_observed": db.execute(
                    "SELECT last_seen FROM assets WHERE ip = ?",
                    (ip,),
                ).fetchone()[0]
            },
        )

    db.commit()

    write_metrics(db)

    db.close()


if __name__ == "__main__":
    main()
