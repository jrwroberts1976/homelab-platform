[Unit]
Description=ASUS network inventory collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/asus-network-inventory
User=root
Group=root
UMask=0022

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/asus-network-inventory /var/lib/prometheus/node-exporter /var/lib/homelab-network-hosts

[Install]
WantedBy=multi-user.target
