[Unit]
Description=Publish homelab patch status metrics
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ automated_patching_status_script }}
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ automated_patching_status_dir }} {{ automated_patching_textfile_dir }}
