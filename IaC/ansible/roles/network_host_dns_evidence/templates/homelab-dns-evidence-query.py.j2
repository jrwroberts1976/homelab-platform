#!/usr/bin/env python3
"""Forced-command Pi-hole query returning minimised per-client DNS evidence.\n\nRaw query history stays on the resolver.  The caller receives only bounded top\ndomains plus small, evidence-qualified ecosystem signals derived locally.\n"""

import ipaddress
import json
import os
import sqlite3
import time

DB = "/etc/pihole/pihole-FTL.db"
GRAVITY_DB = "/etc/pihole/gravity.db"
LOOKBACK_SECONDS = {{ network_host_dns_evidence_lookback_days }} * 24 * 60 * 60
MAX_DOMAINS = {{ network_host_dns_evidence_max_domains }}
RECENT_WINDOW_SECONDS = {{ network_host_dns_evidence_recent_window_seconds }}
RECENT_REQUEST_LIMIT = {{ network_host_dns_evidence_recent_request_limit }}
LAN = ipaddress.ip_network("192.168.2.0/24")

# Deliberately small, reviewable signal vocabulary.  Matching happens on the
# resolver so the full DNS history is never exported to monitor-01.
RISK_LIST_RULES = {
    "threat": (
        "Threat / malware / phishing policy",
        ("threat", "malware", "phishing", "malicious", "abuse"),
    ),
    "adult": (
        "Adult-content policy",
        ("nsfw", "adult", "porn"),
    ),
    "gambling": (
        "Gambling policy",
        ("gambling", "casino", "betting"),
    ),
    "vpn_proxy_tor": (
        "VPN / proxy / Tor / DoH bypass policy",
        ("vpn", "proxy", "tor", "doh", "bypass"),
    ),
}


def classify_adlist(address, comment):
    haystack = (str(address or "") + " " + str(comment or "")).lower()
    for category, (description, needles) in RISK_LIST_RULES.items():
        if any(needle in haystack for needle in needles):
            return category, description
    return "", ""


SIGNAL_RULES = {
    "amazon_fire_tv": (
        "Amazon Fire TV / Amazon Video / Alexa endpoints",
        (
            ".ftv.",
            "ftvpes-",
            "ftvr-",
            "firereleasenotes-",
            ".api.amazonvideo.com",
            ".zaz.api.amazonvideo.com",
            "avs-alexa-",
        ),
    ),
    "nordvpn": (
        "NordVPN endpoints",
        ("nordvpn.com",),
    ),
    "windows_update": (
        "Windows Update / Microsoft delivery endpoints",
        (
            "windowsupdate.com",
            "update.microsoft.com",
            "delivery.mp.microsoft.com",
        ),
    ),
    "tplink_cloud": (
        "TP-Link cloud / Tapo endpoints",
        (
            "tplinkcloud.com",
            "tplinknbu.com",
            "tapo.com",
        ),
    ),
}


def domain_signals(domains):
    signals = []
    lowered = [str(domain).lower().rstrip(".") for domain in domains if domain]
    for signal_id, (description, needles) in SIGNAL_RULES.items():
        matches = []
        for domain in lowered:
            if any(needle in domain for needle in needles):
                matches.append(domain)
            if len(matches) >= 3:
                break
        if matches:
            signals.append({
                "id": signal_id,
                "description": description,
                "examples": matches,
            })
    return signals


def requested_request():
    command = os.environ.get("SSH_ORIGINAL_COMMAND", "").strip().split()
    if len(command) != 3 or command[0] not in ("query", "recent"):
        raise ValueError(
            "Only 'query <LAN-IP> <profiled-at>' or "
            "'recent <LAN-IP> <seconds>' is permitted"
        )
    address = ipaddress.ip_address(command[1])
    if address not in LAN:
        raise ValueError("Requested client is outside the permitted LAN")
    try:
        value = int(command[2])
    except ValueError as exc:
        raise ValueError("Request value must be an integer") from exc
    if value <= 0:
        raise ValueError("Request value must be positive")
    if command[0] == "recent" and value > RECENT_WINDOW_SECONDS:
        raise ValueError("Recent DNS request exceeds permitted lookback")
    return command[0], str(address), value


def query_summary(ip, profiled_at, now=None):
    now = int(time.time()) if now is None else int(now)
    # Anchor the bounded DNS window to the Nmap observation instead of wall
    # clock time. This lets offline devices retain useful identification
    # evidence after they disappear from the network.
    end_at = min(now, int(profiled_at) + 3600)
    cutoff = end_at - LOOKBACK_SECONDS
    uri = "file:" + DB + "?mode=ro"

    with sqlite3.connect(uri, uri=True, timeout=10) as connection:
        connection.execute("PRAGMA query_only=ON")
        columns = {
            row[1]
            for row in connection.execute("PRAGMA table_info(query_storage)")
        }
        required = {"timestamp", "client", "domain"}
        if not required.issubset(columns):
            raise RuntimeError("Unexpected Pi-hole query_storage schema")

        total = connection.execute(
            """
            SELECT COUNT(*)
              FROM query_storage AS q
              JOIN client_by_id AS c ON c.id = q.client
             WHERE c.ip = ? AND q.timestamp >= ? AND q.timestamp <= ?
            """,
            (ip, cutoff, end_at),
        ).fetchone()[0]

        rows = connection.execute(
            """
            SELECT d.domain, COUNT(*) AS hits
              FROM query_storage AS q
              JOIN client_by_id AS c ON c.id = q.client
              JOIN domain_by_id AS d ON d.id = q.domain
             WHERE c.ip = ? AND q.timestamp >= ? AND q.timestamp <= ?
             GROUP BY d.domain
             ORDER BY hits DESC, d.domain ASC
             LIMIT ?
            """,
            (ip, cutoff, end_at, MAX_DOMAINS),
        ).fetchall()

        # Identity classification is performed locally against the distinct
        # domains for this client.  Only bounded signal IDs/descriptions and up
        # to three matching examples per signal leave the resolver.
        distinct_domains = [
            row[0]
            for row in connection.execute(
                """
                SELECT DISTINCT d.domain
                  FROM query_storage AS q
                  JOIN client_by_id AS c ON c.id = q.client
                  JOIN domain_by_id AS d ON d.id = q.domain
                 WHERE c.ip = ? AND q.timestamp >= ? AND q.timestamp <= ?
                   AND d.domain IS NOT NULL
                """,
                (ip, cutoff, end_at),
            ).fetchall()
            if row[0]
        ]

    return {
        "ip": ip,
        "server": os.uname().nodename,
        "query_count": int(total),
        "top_domains": [str(domain) for domain, _ in rows if domain],
        "signals": domain_signals(distinct_domains),
        "lookback_days": LOOKBACK_SECONDS // 86400,
        "observed_at": now,
        "window_start": cutoff,
        "window_end": end_at,
    }


def recent_requests(ip, seconds, now=None):
    """Return only high-risk locally-blocked DNS attempts from the last hour."""
    now = int(time.time()) if now is None else int(now)
    seconds = min(int(seconds), RECENT_WINDOW_SECONDS)
    cutoff = now - seconds
    uri = "file:" + DB + "?mode=ro"
    gravity_uri = "file:" + GRAVITY_DB + "?mode=ro"

    with sqlite3.connect(uri, uri=True, timeout=10) as connection:
        connection.execute("PRAGMA query_only=ON")
        rows = connection.execute(
            """
            SELECT q.timestamp, q.status, d.domain
              FROM query_storage AS q
              JOIN client_by_id AS c ON c.id = q.client
              JOIN domain_by_id AS d ON d.id = q.domain
             WHERE c.ip = ? AND q.timestamp >= ? AND q.timestamp <= ?
               AND q.status IN (1, 9)
               AND d.domain IS NOT NULL
             ORDER BY q.timestamp DESC
             LIMIT 500
            """,
            (ip, cutoff, now),
        ).fetchall()

    matched = []
    if rows and os.path.isfile(GRAVITY_DB):
        with sqlite3.connect(gravity_uri, uri=True, timeout=10) as gravity:
            gravity.execute("PRAGMA query_only=ON")
            for timestamp, status, domain in rows:
                sources = gravity.execute(
                    """
                    SELECT a.address, COALESCE(a.comment, '')
                      FROM gravity AS g
                      JOIN adlist AS a ON a.id = g.adlist_id
                     WHERE g.domain = ?
                    """,
                    (domain,),
                ).fetchall()
                categories = []
                descriptions = []
                for address, comment in sources:
                    category, description = classify_adlist(address, comment)
                    if category and category not in categories:
                        categories.append(category)
                        descriptions.append(description)
                if not categories:
                    continue
                matched.append({
                    "timestamp": int(timestamp),
                    "domain": str(domain)[:255],
                    "status": int(status),
                    "categories": categories,
                    "category_descriptions": descriptions,
                })
                if len(matched) >= RECENT_REQUEST_LIMIT:
                    break

    return {
        "ip": ip,
        "server": os.uname().nodename,
        "window_seconds": seconds,
        "observed_at": now,
        "policy_matches": matched,
        "interpretation_note": (
            "Only DNS attempts blocked by locally configured high-risk policy "
            "lists are returned. Generic ad/tracker blocks and ordinary DNS "
            "requests are intentionally omitted. A match is network evidence "
            "only and does not prove user intent."
        ),
    }


def main():
    mode, ip, value = requested_request()
    payload = (
        query_summary(ip, value)
        if mode == "query"
        else recent_requests(ip, value)
    )
    print(json.dumps(
        payload,
        separators=(",", ":"),
        sort_keys=True,
    ))


if __name__ == "__main__":
    main()
