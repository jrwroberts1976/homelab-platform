# Managed by homelab-platform IaC. Native BirdNET-Go stays on HTTP/8080.
# Existing qBittorrent HTTPS server block remains unchanged.
server {
    listen 443 ssl;
    server_name {{ media_birdnet_https_fqdn }};

    ssl_certificate {{ media_birdnet_https_cert_fullchain }};
    ssl_certificate_key {{ media_birdnet_https_cert_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    location / {
        proxy_pass http://{{ media_birdnet_https_backend }}:{{ media_birdnet_https_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
