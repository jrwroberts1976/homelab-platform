# Managed by homelab-platform/IaC. Manual edits will be overwritten.

compatibility_level = 3.6

myhostname = {{ mail_relay_hostname }}.{{ mail_relay_domain }}
mydomain = {{ mail_relay_domain }}
myorigin = $myhostname

inet_interfaces = all
inet_protocols = ipv4

# Keep the relay internal and do not accept unauthorised relay clients.
mynetworks = {{ mail_relay_allowed_clients | join(', ') }}
smtpd_client_restrictions = permit_mynetworks, reject
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination
disable_vrfy_command = yes
smtpd_helo_required = yes

# This is a relay-only appliance; local mailbox delivery is not a service.
mydestination = $myhostname, localhost.$mydomain, localhost
local_transport = error:local delivery disabled

relayhost = {{ mail_relay_relayhost }}

smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_sasl_tls_security_options = noanonymous

smtp_tls_security_level = encrypt
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_session_cache_database = btree:$data_directory/smtp_scache

# Gmail should see a sender matching the authenticated account.
sender_canonical_maps = regexp:/etc/postfix/sender_canonical

biff = no
append_dot_mydomain = no
readme_directory = no
