[Unit]
Description=Homelab Greenbone full-LAN weekly vulnerability scan
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStartPre={{ greenbone_scanning_runner }} full-lan --check
ExecStart={{ greenbone_scanning_runner }} full-lan
TimeoutStartSec={{ greenbone_scanning_scan_timeout_seconds + 900 }}
