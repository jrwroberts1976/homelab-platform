---
services:
  vulnerability-tests:
    deploy:
      restart_policy:
        condition: any

  notus-data:
    deploy:
      restart_policy:
        condition: any

  scap-data:
    deploy:
      restart_policy:
        condition: any

  cert-bund-data:
    deploy:
      restart_policy:
        condition: any

  dfn-cert-data:
    deploy:
      restart_policy:
        condition: any

  data-objects:
    deploy:
      restart_policy:
        condition: any

  report-formats:
    deploy:
      restart_policy:
        condition: any

  gsa:
    deploy:
      restart_policy:
        condition: any

  openvas:
    deploy:
      restart_policy:
        condition: any

  gvm-config:
    environment:
      ENABLE_TLS_GENERATION: "false"
      NGINX_HOST: "{{ greenbone_stack_https_fqdn }}"
      NGINX_ACCESS_CONTROL_ALLOW_ORIGIN_HEADER: "https://{{ greenbone_stack_https_fqdn }}"

  nginx:
    ports:
      - "{{ greenbone_stack_bind_ipv4 }}:{{ greenbone_stack_https_port }}:443"
    volumes:
      - "{{ greenbone_stack_tls_dir }}:/etc/nginx/certs:ro"
