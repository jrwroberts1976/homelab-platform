[Unit]
Description=Homelab Network Host One-Time Deep Profiler
After=network-online.target homelab-network-host-collector.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0027

ExecStart={{ network_host_deep_profiler_script }}

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

ReadWritePaths={{ network_host_deep_profiler_state_dir }}
ReadWritePaths={{ network_host_deep_profiler_metrics_dir }}

TimeoutStartSec=30min
