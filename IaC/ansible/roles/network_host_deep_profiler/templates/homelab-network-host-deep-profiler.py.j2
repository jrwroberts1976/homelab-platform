#!/usr/bin/env python3

import json
import os
import subprocess
import tempfile
import time
import xml.etree.ElementTree as ET

from pathlib import Path


INVENTORY_FILE = Path(
    "{{ network_host_deep_profiler_inventory }}"
)

STATE_FILE = Path(
    "{{ network_host_deep_profiler_state }}"
)

METRIC_FILE = Path(
    "{{ network_host_deep_profiler_metrics }}"
)

INTERFACE = "{{ network_host_deep_profiler_interface }}"

RECENT_SEEN_SECONDS = (
    {{ network_host_deep_profiler_recent_seen_seconds }}
)

MAX_PROFILES_PER_RUN = (
    {{ network_host_deep_profiler_max_profiles_per_run }}
)

UDP_PORTS = "{{ network_host_deep_profiler_udp_ports }}"

SAFE_SCRIPTS = "{{ network_host_deep_profiler_scripts }}"

# New-device-only bounded scan is an explicit opt-in; existing deployment stays legacy.
SCAN_MODE = "{{ network_host_deep_profiler_scan_mode }}"
if SCAN_MODE not in ("legacy", "targeted"):
    raise RuntimeError("Invalid network profiler scan mode")

NOW = int(time.time())


def load_json(path, optional=False):
    if optional and not path.exists():
        return None

    if not path.exists():
        raise RuntimeError(
            "Required file does not exist: " + str(path)
        )

    try:
        data = json.loads(path.read_text())
    except Exception as exc:
        raise RuntimeError(
            "Refusing to use unreadable JSON file: "
            + str(path)
        ) from exc

    if not isinstance(data, dict):
        raise RuntimeError(
            "Invalid JSON structure in: " + str(path)
        )

    return data


def save_atomic(path, text, mode):
    path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    fd, tmp = tempfile.mkstemp(
        dir=str(path.parent),
        prefix="." + path.name + ".",
    )

    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())

        os.chmod(tmp, mode)
        os.replace(tmp, path)

    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def normalise_mac(value):
    return str(value or "").strip().lower()


def ip_sort(value):
    try:
        return tuple(
            int(part)
            for part in value.split(".")
        )
    except Exception:
        return (999, 999, 999, 999)


INITIAL_RETRY_SECONDS = 24 * 60 * 60
WEEKLY_RETRY_SECONDS = 7 * 24 * 60 * 60


def scan_retry_seconds(record):
    """Retry once after 24h, then weekly while evidence stays incomplete."""
    attempts = int(record.get("attempt_count", 0) or 0)
    return INITIAL_RETRY_SECONDS if attempts <= 1 else WEEKLY_RETRY_SECONDS


def scan_due(record, now, cooldown=None):
    last_attempt = int(record.get("last_attempt", 0) or 0)

    if last_attempt <= 0:
        return True

    if cooldown is None:
        cooldown = scan_retry_seconds(record)

    return now - last_attempt >= cooldown


def tcp_has_os_evidence(tcp):
    return bool(
        isinstance(tcp, dict)
        and isinstance(tcp.get("os_matches"), list)
        and tcp.get("os_matches")
    )


def persist_profiles(state, profiles):
    state["profiles"] = profiles
    save_atomic(
        STATE_FILE,
        json.dumps(state, indent=2, sort_keys=True) + "\n",
        0o600,
    )


def merge_scan_evidence(
    previous_profile,
    tcp,
    udp,
    udp_error,
    now,
):
    """Merge successful scans without replacing failed UDP evidence."""
    previous = previous_profile or {}

    result = {
        "tcp": tcp,
        "tcp_scanned_at": now,
        "errors": {},
    }

    if udp_error:
        result["errors"]["udp"] = str(udp_error)

        if "udp" in previous:
            result["udp"] = previous["udp"]
            result["udp_scanned_at"] = previous.get(
                "udp_scanned_at",
                previous.get("scanned_at"),
            )
            result["udp_evidence_stale"] = True
        else:
            result["udp"] = {
                "os_matches": [],
                "ports": [],
            }
            result["udp_scanned_at"] = None
            result["udp_evidence_stale"] = False
    else:
        result["udp"] = udp
        result["udp_scanned_at"] = now
        result["udp_evidence_stale"] = False

    return result


def run_nmap(args, timeout=1800):
    result = subprocess.run(
        ["nmap", *args],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )

    if result.returncode != 0:
        raise RuntimeError(
            "nmap failed: "
            + result.stderr.strip()
        )

    return result.stdout


def fresh_arp_presence(ip, expected_mac):
    if not ip or not normalise_mac(expected_mac):
        return False

    xml = run_nmap(
        [
            "-sn",
            "-PR",
            "-n",
            "-e",
            INTERFACE,
            "-oX",
            "-",
            ip,
        ],
        timeout=30,
    )

    root = ET.fromstring(xml)

    for host in root.findall("host"):
        status = host.find("status")

        if status is None or status.get("state") != "up":
            continue

        addresses = {
            item.get("addrtype"): item.get("addr", "")
            for item in host.findall("address")
        }

        if (
            addresses.get("ipv4") == ip
            and normalise_mac(addresses.get("mac"))
            == normalise_mac(expected_mac)
        ):
            return True

    return False


def validate_scan_xml(xml, expected_ip):
    root = ET.fromstring(xml)

    if root.tag != "nmaprun":
        raise ValueError("Unexpected Nmap XML root")

    finished = root.find("./runstats/finished")

    if finished is None or finished.get("exit") != "success":
        raise ValueError("Nmap scan did not finish successfully")

    matches = []

    for host in root.findall("host"):
        addresses = [
            address.get("addr", "")
            for address in host.findall("address")
            if address.get("addrtype") == "ipv4"
        ]

        if expected_ip in addresses:
            matches.append(host)

    if len(matches) != 1:
        raise ValueError(
            "Expected exactly one host matching " + expected_ip
        )

    host = matches[0]
    status = host.find("status")

    if status is None or status.get("state") != "up":
        raise ValueError("Target host is not marked up")

    return host


def parse_host(xml, expected_ip):
    host = validate_scan_xml(xml, expected_ip)

    os_matches = []

    for match in host.findall("./os/osmatch")[:5]:
        classes = []

        for item in match.findall("osclass")[:5]:
            classes.append({
                "type": item.get("type", ""),
                "vendor": item.get("vendor", ""),
                "os_family": item.get("osfamily", ""),
                "os_generation": item.get("osgen", ""),
                "accuracy": item.get("accuracy", ""),
                "cpe": [
                    element.text
                    for element in item.findall("cpe")
                    if element.text
                ],
            })

        os_matches.append({
            "name": match.get("name", ""),
            "accuracy": match.get("accuracy", ""),
            "classes": classes,
        })

    ports = []

    for port in host.findall("./ports/port"):
        state = port.find("state")

        if state is None:
            continue

        state_name = state.get("state", "")

        if state_name not in (
            "open",
            "open|filtered",
        ):
            continue

        service = port.find("service")

        service_data = {
            "name": "",
            "product": "",
            "version": "",
            "extra_info": "",
            "os_type": "",
            "device_type": "",
            "hostname": "",
            "tunnel": "",
            "cpe": [],
        }

        if service is not None:
            service_data.update({
                "name": service.get("name", ""),
                "product": service.get("product", ""),
                "version": service.get("version", ""),
                "extra_info": service.get(
                    "extrainfo",
                    "",
                ),
                "os_type": service.get(
                    "ostype",
                    "",
                ),
                "device_type": service.get(
                    "devicetype",
                    "",
                ),
                "hostname": service.get(
                    "hostname",
                    "",
                ),
                "tunnel": service.get(
                    "tunnel",
                    "",
                ),
                "cpe": [
                    element.text
                    for element in service.findall("cpe")
                    if element.text
                ],
            })

        scripts = {}

        for script in port.findall("script"):
            output = " ".join(
                script.get("output", "").split()
            )

            # Keep detail in JSON, but bound individual output.
            scripts[script.get("id", "")] = output[:4000]

        ports.append({
            "protocol": port.get("protocol", ""),
            "port": int(
                port.get("portid", "0")
            ),
            "state": state_name,
            "service": service_data,
            "scripts": scripts,
        })

    ports.sort(
        key=lambda item: (
            item["protocol"],
            item["port"],
        )
    )

    return {
        "os_matches": os_matches,
        "ports": ports,
    }


def targeted_tcp_arguments(ip):
    return [
        "-sS", "-sV", "--version-light", "-O", "--osscan-limit",
        "--max-os-tries", "1", "-Pn", "-n", "-T2",
        "--max-rate", "100", "--max-retries", "1",
        "--host-timeout", "150s", "--top-ports", "100",
        "-oX", "-", ip,
    ]


def deep_tcp_scan(ip):
    if SCAN_MODE == "targeted":
        return parse_host(
            run_nmap(targeted_tcp_arguments(ip), timeout=210), ip
        )
    xml = run_nmap([
        "-sS",
        "-sV",
        "--version-all",
        "-O",
        "--osscan-guess",
        "--max-os-tries",
        "2",
        "-Pn",
        "-n",
        "-T3",
        "--max-retries",
        "2",
        "--host-timeout",
        "20m",
        "-p-",
        "--script",
        SAFE_SCRIPTS,
        "-oX",
        "-",
        ip,
    ])

    return parse_host(xml, ip)


def deep_udp_scan(ip):
    xml = run_nmap([
        "-sU",
        "-sV",
        "--version-light",
        "-Pn",
        "-n",
        "-T3",
        "--max-retries",
        "1",
        "--host-timeout",
        "10m",
        "-p",
        UDP_PORTS,
        "-oX",
        "-",
        ip,
    ])

    return parse_host(xml, ip)


def prom_escape(value):
    return (
        str(value)
        .replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", " ")
    )


def write_metrics(profiles):
    metrics = [
        "# HELP homelab_network_host_deep_profile_state Current one-time deep profiling state for a MAC address.",
        "# TYPE homelab_network_host_deep_profile_state gauge",
        "# HELP homelab_network_host_deep_profile_open_tcp_ports_total Open TCP ports found by the one-time deep profile.",
        "# TYPE homelab_network_host_deep_profile_open_tcp_ports_total gauge",
        "# HELP homelab_network_host_deep_profile_last_success_seconds Unix timestamp of the completed one-time profile.",
        "# TYPE homelab_network_host_deep_profile_last_success_seconds gauge",
    ]

    for mac in sorted(profiles):
        record = profiles[mac]

        state_labels = (
            'mac="' + prom_escape(mac) + '",'
            'status="' + prom_escape(
                record.get("status", "")
            ) + '"'
        )

        metrics.append(
            "homelab_network_host_deep_profile_state{"
            + state_labels
            + "} 1"
        )

        if record.get("status") not in ("complete", "partial"):
            continue

        profile = record.get("profile", {})

        # A partial profile can still contain valid TCP evidence.
        if not isinstance(profile.get("tcp"), dict):
            continue

        tcp_ports = [
            item
            for item in profile.get(
                "tcp",
                {},
            ).get("ports", [])
            if item.get("state") == "open"
        ]

        info_labels = (
            'mac="' + prom_escape(mac) + '",'
            'ip="' + prom_escape(
                record.get("profiled_ip", "")
            ) + '"'
        )

        metrics.append(
            "homelab_network_host_deep_profile_open_tcp_ports_total{"
            + info_labels
            + "} "
            + str(len(tcp_ports))
        )

        if record.get("status") != "complete":
            continue

        metrics.append(
            "homelab_network_host_deep_profile_last_success_seconds{"
            + 'mac="' + prom_escape(mac) + '"'
            + "} "
            + str(
                int(
                    record.get(
                        "profiled_at",
                        0,
                    ) or 0
                )
            )
        )

    save_atomic(
        METRIC_FILE,
        "\n".join(metrics) + "\n",
        0o644,
    )


inventory = load_json(INVENTORY_FILE)

state = load_json(
    STATE_FILE,
    optional=True,
)

# First ever execution is a BASELINE ONLY.
#
# Existing devices become grandfathered so deploying this feature
# does not launch deep scans against the whole current estate.
if state is None:
    profiles = {}

    for ip in sorted(
        inventory,
        key=ip_sort,
    ):
        host = inventory[ip]
        mac = normalise_mac(
            host.get("mac", "")
        )

        if not mac:
            continue

        profiles[mac] = {
            "status": "baseline",
            "baselined_at": NOW,
            "first_known": int(
                host.get(
                    "first_seen",
                    NOW,
                ) or NOW
            ),
            "last_inventory_seen": int(
                host.get(
                    "last_seen",
                    0,
                ) or 0
            ),
            "last_ip": ip,
            "hostname": host.get(
                "hostname",
                "",
            ),
            "vendor": host.get(
                "vendor",
                "",
            ),
        }

    state = {
        "schema_version": 1,
        "initialized_at": NOW,
        "profiles": profiles,
    }

    save_atomic(
        STATE_FILE,
        json.dumps(
            state,
            indent=2,
            sort_keys=True,
        ) + "\n",
        0o600,
    )

    write_metrics(profiles)

    print(
        json.dumps({
            "event": "deep_profile_baseline_created",
            "existing_macs": len(profiles),
            "deep_scans_started": 0,
        }),
        flush=True,
    )

    raise SystemExit(0)


profiles = state.get("profiles")

if not isinstance(profiles, dict):
    raise RuntimeError(
        "Refusing to overwrite invalid deep profile state"
    )


# Reconcile the current V1 inventory into MAC-keyed state.
for ip in sorted(
    inventory,
    key=ip_sort,
):
    host = inventory[ip]

    mac = normalise_mac(
        host.get("mac", "")
    )

    if not mac:
        continue

    record = profiles.get(mac)

    if record is None:
        record = {
            "status": "pending",
            "discovered_at": NOW,
            "attempt_count": 0,
            "last_presence_check": 0,
            "last_error": "",
        }

        profiles[mac] = record

        print(
            json.dumps({
                "event": "new_mac_pending_deep_profile",
                "mac": mac,
                "ip": ip,
                "hostname": host.get(
                    "hostname",
                    "",
                ),
                "vendor": host.get(
                    "vendor",
                    "",
                ),
            }),
            flush=True,
        )

    record["last_ip"] = ip
    record["last_inventory_seen"] = int(
        host.get(
            "last_seen",
            0,
        ) or 0
    )

    if host.get("hostname"):
        record["hostname"] = host["hostname"]

    if host.get("vendor"):
        record["vendor"] = host["vendor"]


profiles_started = 0

pending = sorted(
    [
        (mac, record)
        for mac, record in profiles.items()
        if record.get("status") in ("pending", "partial")
    ],
    key=lambda item: int(
        item[1].get(
            "discovered_at",
            0,
        ) or 0
    ),
)


for mac, record in pending:
    if profiles_started >= MAX_PROFILES_PER_RUN:
        break

    ip = record.get("last_ip", "")

    if not ip:
        continue

    last_seen = int(
        record.get(
            "last_inventory_seen",
            0,
        ) or 0
    )

    age = NOW - last_seen

    # This is what protects us from the .252 situation:
    # V1's grace-period online state alone is never sufficient.
    if (
        last_seen <= 0
        or age > RECENT_SEEN_SECONDS
    ):
        continue

    if not scan_due(record, NOW):
        continue

    record["last_presence_check"] = NOW

    try:
        live = fresh_arp_presence(ip, mac)
    except Exception as exc:
        record["last_error"] = (
            "presence_check: " + str(exc)
        )
        persist_profiles(state, profiles)
        continue

    if not live:
        record["last_error"] = (
            "fresh_arp_presence_failed"
        )
        persist_profiles(state, profiles)

        print(
            json.dumps({
                "event": "deep_profile_waiting_for_presence",
                "mac": mac,
                "ip": ip,
            }),
            flush=True,
        )

        continue

    record["attempt_count"] = int(
        record.get(
            "attempt_count",
            0,
        ) or 0
    ) + 1

    record["last_attempt"] = NOW
    record["last_error"] = ""
    profiles_started += 1

    # Persist before Nmap: a crash must not bypass the cooldown.
    persist_profiles(state, profiles)

    previous_profile = record.get("profile", {})

    # Reuse TCP evidence only for a partial profile at the same IP.
    udp_only = (
        SCAN_MODE == "legacy"
        and record.get("status") == "partial"
        and isinstance(previous_profile, dict)
        and isinstance(previous_profile.get("tcp"), dict)
        and previous_profile.get("tcp_scanned_at") is not None
        and record.get("profiled_ip") == ip
    )

    if udp_only:
        tcp = previous_profile["tcp"]
    else:
        try:
            tcp = deep_tcp_scan(ip)
        except Exception as exc:
            record["last_error"] = (
                "tcp_scan: " + str(exc)
            )

            persist_profiles(state, profiles)

            print(
                json.dumps({
                    "event": "deep_profile_failed",
                    "mac": mac,
                    "ip": ip,
                    "error": record["last_error"],
                }),
                flush=True,
            )

            continue

    udp_error = None

    if SCAN_MODE == "targeted":
        udp = {"os_matches": [], "ports": []}
    else:
        try:
            udp = deep_udp_scan(ip)
        except Exception as exc:
            udp = None
            udp_error = str(exc)

    # Evidence from a previous IP must not appear current.
    previous_ip = record.get("profiled_ip", "")
    ip_changed = bool(previous_ip and previous_ip != ip)

    merge_previous = (
        {}
        if ip_changed
        else previous_profile
    )

    merged_profile = merge_scan_evidence(
        merge_previous,
        tcp,
        udp,
        udp_error,
        NOW,
    )

    # Retain at most five historical UDP observations per MAC.
    # Accept the older single-entry format during migration.
    history = []

    if isinstance(previous_profile, dict):
        existing = previous_profile.get("historical_udp_entries", [])

        if isinstance(existing, list):
            history = [
                entry
                for entry in existing
                if isinstance(entry, dict)
            ]

        legacy = previous_profile.get("historical_udp")

        if isinstance(legacy, dict) and legacy not in history:
            history.append(legacy)

        if ip_changed:
            previous_udp = previous_profile.get("udp")
            previous_udp_time = previous_profile.get(
                "udp_scanned_at",
                previous_profile.get("scanned_at"),
            )

            # Empty results from failed scans are not observations.
            if (
                isinstance(previous_udp, dict)
                and previous_udp_time is not None
            ):
                entry = {
                    "ip": previous_ip,
                    "evidence": previous_udp,
                    "scanned_at": previous_udp_time,
                }

                if entry not in history:
                    history.append(entry)

    if history:
        merged_profile["historical_udp_entries"] = history[-5:]

    if udp_only:
        merged_profile["tcp_scanned_at"] = (
            previous_profile["tcp_scanned_at"]
        )

    missing_os = (
        SCAN_MODE == "targeted"
        and not tcp_has_os_evidence(tcp)
    )
    partial = bool(merged_profile["errors"]) or missing_os

    if merged_profile["errors"].get("udp"):
        last_error = "udp_scan: " + merged_profile["errors"]["udp"]
    elif missing_os:
        last_error = "os_evidence_missing"
    else:
        last_error = ""

    record.update({
        "status": "partial" if partial else "complete",
        "profiled_at": NOW,
        "profiled_ip": ip,
        "last_error": last_error,
        "needs_os_identification": missing_os,
        "next_retry_after": (
            NOW + scan_retry_seconds(record)
            if partial else 0
        ),
        "profile": merged_profile,
    })

    # Persist completed evidence before processing another device.
    persist_profiles(state, profiles)

    print(
        json.dumps({
            "event": (
                "deep_profile_partial"
                if partial
                else "deep_profile_complete"
            ),
            "mac": mac,
            "ip": ip,
            "hostname": record.get(
                "hostname",
                "",
            ),
            "tcp_open_ports": len(
                tcp.get("ports", [])
            ),
            "udp_interesting_ports": len(
                merged_profile["udp"].get("ports", [])
            ),
            "partial": bool(merged_profile["errors"]),
        }),
        flush=True,
    )


state["profiles"] = profiles
state["last_run"] = NOW

save_atomic(
    STATE_FILE,
    json.dumps(
        state,
        indent=2,
        sort_keys=True,
    ) + "\n",
    0o600,
)

write_metrics(profiles)

print(
    json.dumps({
        "event": "deep_profiler_worker_complete",
        "pending": sum(
            1
            for item in profiles.values()
            if item.get("status") == "pending"
        ),
        "complete": sum(
            1
            for item in profiles.values()
            if item.get("status") == "complete"
        ),
        "partial": sum(
            1
            for item in profiles.values()
            if item.get("status") == "partial"
        ),
        "baseline": sum(
            1
            for item in profiles.values()
            if item.get("status") == "baseline"
        ),
        "deep_scans_started_this_run": profiles_started,
    }),
    flush=True,
)
