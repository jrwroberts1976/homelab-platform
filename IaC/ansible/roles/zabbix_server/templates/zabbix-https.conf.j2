# Managed by Ansible - homelab-platform
server {
        listen {{ zabbix_server_https_listen }} ssl;
        server_name {{ zabbix_server_https_fqdn }};

        ssl_certificate {{ zabbix_server_https_certificate }};
        ssl_certificate_key {{ zabbix_server_https_private_key }};

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:ZABBIX_SSL:10m;
        ssl_session_timeout 1d;

        location / {
                proxy_pass {{ zabbix_server_https_backend }};
                proxy_http_version 1.1;

                # Zabbix backend is HTTP-only behind this trusted TLS proxy.
                # Ensure the external session cookie cannot be sent over HTTP.
                proxy_cookie_flags zbx_session secure;

                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto https;
        }
}
