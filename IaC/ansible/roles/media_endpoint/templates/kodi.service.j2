[Unit]
Description=Kodi standalone media centre
After=remote-fs.target network-online.target systemd-user-sessions.service sound.target
Wants=network-online.target
Conflicts=getty@tty1.service lightdm.service

[Service]
Type=simple
User={{ media_user }}
Group={{ media_user }}
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=HOME={{ media_user_home }}
ExecStart=/usr/bin/kodi-standalone
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=graphical.target
