[Unit]
Description=Kodi standalone media centre
After=remote-fs.target network-online.target systemd-user-sessions.service sound.target
Wants=network-online.target
Conflicts=getty@tty1.service lightdm.service

[Service]
Type=simple
User={{ media_user }}
Group={{ media_user }}
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=HOME={{ media_user_home }}
ExecStartPre=-/usr/bin/pkill -KILL -u {{ media_user }} -x kodi.bin
ExecStart=/usr/bin/kodi-standalone
ExecStopPost=-/usr/bin/pkill -KILL -u {{ media_user }} -x kodi.bin
KillMode=control-group
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=graphical.target
