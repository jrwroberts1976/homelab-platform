#!/usr/bin/env python3
import json
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REPO = Path("{{ network_host_docs_sync_repo_path }}")
HOSTS_DIR = REPO / "docs" / "network" / "hosts"
INDEX = HOSTS_DIR / "README.md"
REMOTE = "{{ network_host_docs_sync_git_remote }}"
BRANCH = "{{ network_host_docs_sync_git_branch }}"
SENSOR = "{{ network_host_docs_sync_sensor_user }}@{{ network_host_docs_sync_sensor_host }}"
FLOW_SUMMARY = "{{ network_host_docs_sync_flow_summary }}"
AI_SOURCE = "{{ network_host_docs_sync_ai_user }}@{{ network_host_docs_sync_ai_host }}"
AI_SUMMARY = "{{ network_host_docs_sync_ai_summary }}"
BEGIN = "<!-- BEGIN AUTO:ZEEK-FLOW -->"
END = "<!-- END AUTO:ZEEK-FLOW -->"
AI_BEGIN = "<!-- BEGIN AUTO:AI-ASSESSMENT -->"
AI_END = "<!-- END AUTO:AI-ASSESSMENT -->"

def run(argv, *, check=True, capture=True, cwd=None):
    result = subprocess.run(
        argv,
        cwd=cwd,
        text=True,
        capture_output=capture,
    )
    if check and result.returncode != 0:
        if result.stdout:
            print(result.stdout, end="", file=sys.stderr)
        if result.stderr:
            print(result.stderr, end="", file=sys.stderr)
        raise SystemExit(f"command failed ({result.returncode}): {' '.join(argv)}")
    return result

def format_bytes(value):
    try:
        n = float(value or 0)
    except Exception:
        n = 0.0
    units = ["B", "KiB", "MiB", "GiB", "TiB"]
    for unit in units:
        if n < 1024 or unit == units[-1]:
            if unit == "B":
                return f"{int(n)} {unit}"
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} TiB"

def fmt_ranked(items, key):
    rendered = []
    for item in (items or [])[:6]:
        if not isinstance(item, dict):
            continue
        name = str(item.get(key, "") or "").strip()
        count = item.get("count", 0)
        if name:
            rendered.append(f"`{name}` ({count})")
    return ", ".join(rendered) if rendered else "None observed"

def parse_index():
    mapping = {}
    pattern = re.compile(
        r"^\|\s*[^|]+\|\s*`([^\`]+)`\s*\|\s*`([0-9A-Fa-f:]{17})`\s*\|\s*\[Open\]\(([^)]+\.md)\)\s*\|$"
    )
    for line in INDEX.read_text().splitlines():
        match = pattern.match(line)
        if not match:
            continue
        ip, mac, filename = match.groups()
        mapping[mac.lower()] = {"ip": ip, "filename": filename}
    if not mapping:
        raise SystemExit(f"No host mappings parsed from {INDEX}")
    return mapping

def render_block(mac, summary, record):
    generated = int(summary.get("generated_at", 0) or 0)
    if generated:
        stamp = datetime.fromtimestamp(generated, tz=timezone.utc).astimezone().isoformat(timespec="seconds")
    else:
        stamp = "unknown"

    window_seconds = int(summary.get("window_seconds", 0) or 0)
    window_hours = window_seconds / 3600 if window_seconds else 0

    lines = [
        BEGIN,
        "### Automated Zeek summary",
        "",
        f"- Evidence source: `sensor-01` Zeek connection telemetry",
        f"- Rolling window: {window_hours:g} hours",
        f"- Summary generated: `{stamp}`",
        f"- MAC identity: `{mac}`",
    ]

    if record is None:
        lines.extend([
            "- MAC-attributable originated connections: **none observed in this window**",
            "",
            "> This bounded summary intentionally excludes raw packet data and external destination IP history.",
            END,
        ])
        return "\n".join(lines)

    ips = ", ".join(f"`{ip}`" for ip in record.get("ips", []) if ip) or "None recorded"
    lines.extend([
        f"- Observed IP address(es): {ips}",
        f"- Connections: **{int(record.get('connections', 0) or 0):,}**",
        f"- Traffic sent: **{format_bytes(record.get('bytes_out', 0))}**",
        f"- Traffic received: **{format_bytes(record.get('bytes_in', 0))}**",
        f"- Top services: {fmt_ranked(record.get('top_services'), 'name')}",
        f"- Top destination ports: {fmt_ranked(record.get('top_ports'), 'name')}",
        "",
        "> This bounded summary intentionally excludes raw packet data and external destination IP history.",
        END,
    ])
    return "\n".join(lines)

def md_text(value):
    return " ".join(str(value or "").replace("\r", " ").replace("\n", " ").split())


def render_ai_block(mac, record):
    result = record.get("result", {}) if isinstance(record, dict) else {}
    if not isinstance(result, dict):
        result = {}

    assessed_at = int(record.get("assessed_at", 0) or 0)
    if assessed_at:
        stamp = datetime.fromtimestamp(
            assessed_at, tz=timezone.utc
        ).astimezone().isoformat(timespec="seconds")
    else:
        stamp = "unknown"

    identity_confidence = md_text(result.get("identity_confidence")) or "unknown"
    os_confidence = md_text(result.get("os_confidence")) or "unknown"
    manual_review = "Yes" if result.get("manual_review_required", True) else "No"
    exact_os = md_text(result.get("exact_os")) or "Not established"
    summary = md_text(result.get("summary")) or "No summary supplied."

    lines = [
        AI_BEGIN,
        "## AI-assisted host assessment",
        "",
        "> Advisory interpretation of bounded host evidence. Canonical inventory and direct telemetry remain authoritative.",
        "",
        f"- Assessed: `{stamp}`",
        f"- Model: `{md_text(record.get('model')) or 'unknown'}`",
        f"- MAC identity: `{mac}`",
        f"- Identity confidence: **{identity_confidence}**",
        f"- OS confidence: **{os_confidence}**",
        f"- Exact OS: **{exact_os}**",
        f"- Manual review required: **{manual_review}**",
        "",
        "### Assessment summary",
        "",
        summary,
        "",
        "### Confirmed facts",
        "",
    ]

    facts = result.get("confirmed_facts", [])
    if isinstance(facts, list) and facts:
        lines.extend(f"- {md_text(item)}" for item in facts[:20] if md_text(item))
    else:
        lines.append("- None supplied.")

    lines.extend(["", "### Inferences", ""])
    inferences = result.get("inferences", [])
    if isinstance(inferences, list) and inferences:
        lines.extend(
            f"- {md_text(item)}" for item in inferences[:20] if md_text(item)
        )
    else:
        lines.append("- None supplied.")

    lines.extend([
        "",
        "> Greenbone zero-match results are not proof that a host is vulnerability-free. Nmap service labels and OS fingerprints remain evidence, not authoritative identity, unless corroborated.",
        AI_END,
    ])
    return "\n".join(lines)


def update_ai_section(path, block):
    text = path.read_text()
    pattern = re.compile(
        re.escape(AI_BEGIN) + r".*?" + re.escape(AI_END),
        flags=re.DOTALL,
    )
    if pattern.search(text):
        updated = pattern.sub(block, text, count=1)
    else:
        heading = "## Monitoring and security"
        pos = text.find(heading)
        if pos < 0:
            raise SystemExit(f"Missing '{heading}' in {path}")
        updated = text[:pos] + block + "\n\n" + text[pos:]

    if updated == text:
        return False
    path.write_text(updated)
    return True


def update_network_flow_section(path, block):
    text = path.read_text()
    auto_pattern = re.compile(
        re.escape(BEGIN) + r".*?" + re.escape(END),
        flags=re.DOTALL,
    )
    if auto_pattern.search(text):
        updated = auto_pattern.sub(block, text, count=1)
    else:
        heading = "## Network flows"
        pos = text.find(heading)
        if pos < 0:
            raise SystemExit(f"Missing '{heading}' in {path}")
        insert_at = pos + len(heading)
        updated = text[:insert_at] + "\n\n" + block + text[insert_at:]

    if updated == text:
        return False
    path.write_text(updated)
    return True

def main():
    if not REPO.is_dir():
        raise SystemExit(f"Repository path missing: {REPO}")
    if not INDEX.is_file():
        raise SystemExit(f"Host index missing: {INDEX}")

    branch = run(["git", "-C", str(REPO), "branch", "--show-current"]).stdout.strip()
    if branch != BRANCH:
        raise SystemExit(f"Refusing docs sync: expected branch {BRANCH}, found {branch or 'detached HEAD'}")

    dirty = run(["git", "-C", str(REPO), "status", "--porcelain"]).stdout.strip()
    if dirty:
        raise SystemExit("Refusing docs sync: repository working tree is not clean")

    run(["git", "-C", str(REPO), "pull", "--ff-only", REMOTE, BRANCH], capture=True)

    result = run([
        "ssh",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=10",
        SENSOR,
        "cat", FLOW_SUMMARY,
    ])
    try:
        summary = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid Zeek flow summary JSON: {exc}")

    if summary.get("schema_version") != 1:
        raise SystemExit(f"Unsupported Zeek flow summary schema: {summary.get('schema_version')}")
    devices = summary.get("devices")
    if not isinstance(devices, dict):
        raise SystemExit("Zeek flow summary does not contain a devices object")

    ai_result = run([
        "ssh",
        "-o", "BatchMode=yes",
        "-o", "ConnectTimeout=10",
        AI_SOURCE,
        "cat", AI_SUMMARY,
    ])
    try:
        ai_summary = json.loads(ai_result.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit(f"Invalid AI assessment JSON: {exc}")
    if ai_summary.get("schema_version") != 1:
        raise SystemExit(
            f"Unsupported AI assessment schema: {ai_summary.get('schema_version')}"
        )
    ai_devices = ai_summary.get("devices")
    if not isinstance(ai_devices, dict):
        raise SystemExit("AI assessment does not contain a devices object")

    mapping = parse_index()
    changed = []
    missing_files = []

    for mac, meta in sorted(mapping.items()):
        page = HOSTS_DIR / meta["filename"]
        if not page.is_file():
            missing_files.append(str(page))
            continue
        record = devices.get(mac)
        block = render_block(mac, summary, record if isinstance(record, dict) else None)
        page_changed = update_network_flow_section(page, block)

        ai_record = ai_devices.get(mac)
        if isinstance(ai_record, dict) and ai_record.get("result"):
            ai_block = render_ai_block(mac, ai_record)
            page_changed = update_ai_section(page, ai_block) or page_changed

        if page_changed:
            changed.append(page)

    if missing_files:
        raise SystemExit("Mapped host record(s) missing: " + ", ".join(missing_files))

    if not changed:
        print(f"host_records={len(mapping)} active_flow_records={len(devices)} ai_records={len(ai_devices)} changed=0")
        return

    relpaths = [str(p.relative_to(REPO)) for p in changed]
    run(["git", "-C", str(REPO), "add", "--", *relpaths])

    cached = run(["git", "-C", str(REPO), "diff", "--cached", "--quiet"], check=False)
    if cached.returncode == 0:
        print(f"host_records={len(mapping)} active_flow_records={len(devices)} changed=0")
        return
    if cached.returncode != 1:
        raise SystemExit("Unable to determine staged Git diff state")

    stamp = datetime.now().astimezone().strftime("%Y-%m-%d")
    run([
        "git", "-C", str(REPO), "commit",
        "-m", f"Update bounded Zeek host flow summaries ({stamp})",
    ], capture=False)
    run(["git", "-C", str(REPO), "push", REMOTE, BRANCH], capture=False)

    print(
        f"host_records={len(mapping)} active_flow_records={len(devices)} "
        f"ai_records={len(ai_devices)} changed={len(changed)} pushed={REMOTE}/{BRANCH}"
    )

if __name__ == "__main__":
    main()
