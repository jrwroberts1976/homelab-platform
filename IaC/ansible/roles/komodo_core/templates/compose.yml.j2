services:
  mongo:
    image: "{{ komodo_core_mongo_image }}"
    restart: unless-stopped
    labels:
      komodo.skip: ""
    command:
      - --quiet
      - --wiredTigerCacheSizeGB
      - "0.25"
    environment:
      MONGO_INITDB_ROOT_USERNAME: "{{ komodo_core_database_username }}"
      MONGO_INITDB_ROOT_PASSWORD_FILE: /run/secrets/mongo_database_password
    secrets:
      - mongo_database_password
    volumes:
      - mongo-data:/data/db
      - mongo-config:/data/configdb
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          mongosh --quiet
          --username "{{ komodo_core_database_username }}"
          --password "$$(cat /run/secrets/mongo_database_password)"
          --authenticationDatabase admin
          --eval 'quit(db.adminCommand({ ping: 1 }).ok ? 0 : 1)'
      interval: 10s
      timeout: 5s
      retries: 18
      start_period: 30s
    networks:
      - komodo_backend

  core:
    image: "{{ komodo_core_image }}"
    init: true
    restart: unless-stopped
    depends_on:
      mongo:
        condition: service_healthy
    ports:
      - "{{ komodo_core_http_bind }}:{{ komodo_core_http_port }}:9120"
    environment:
      TZ: "{{ komodo_core_timezone }}"

      KOMODO_HOST: "{{ komodo_core_host_url }}"
      KOMODO_TITLE: "{{ komodo_core_title }}"

      KOMODO_DATABASE_ADDRESS: "mongo:27017"
      KOMODO_DATABASE_USERNAME: "{{ komodo_core_database_username }}"
      KOMODO_DATABASE_PASSWORD_FILE: /run/secrets/komodo_database_password

      KOMODO_LOCAL_AUTH: "true"
      KOMODO_INIT_ADMIN_USERNAME: "{{ komodo_core_admin_username }}"
      KOMODO_INIT_ADMIN_PASSWORD_FILE: /run/secrets/komodo_admin_password

      KOMODO_JWT_SECRET_FILE: /run/secrets/komodo_jwt_secret
      KOMODO_WEBHOOK_SECRET_FILE: /run/secrets/komodo_webhook_secret

      KOMODO_JWT_TTL: "1-day"
      KOMODO_DISABLE_USER_REGISTRATION: "true"
      KOMODO_ENABLE_NEW_USERS: "false"
      KOMODO_DISABLE_CONFIRM_DIALOG: "false"
      KOMODO_MONITORING_INTERVAL: "15-sec"
      KOMODO_RESOURCE_POLL_INTERVAL: "1-hr"

    secrets:
      - komodo_database_password
      - komodo_admin_password
      - komodo_jwt_secret
      - komodo_webhook_secret

    volumes:
      - komodo-keys:/config/keys
      - "{{ komodo_core_backup_root }}:/backups"

    networks:
      - komodo_backend

networks:
  komodo_backend:
    driver: bridge

volumes:
  mongo-data:
  mongo-config:
  komodo-keys:

secrets:
  mongo_database_password:
    file: "{{ komodo_core_secret_root }}/mongo_database_password"

  komodo_database_password:
    file: "{{ komodo_core_secret_root }}/database_password"

  komodo_admin_password:
    file: "{{ komodo_core_secret_root }}/admin_password"

  komodo_jwt_secret:
    file: "{{ komodo_core_secret_root }}/jwt_secret"

  komodo_webhook_secret:
    file: "{{ komodo_core_secret_root }}/webhook_secret"
