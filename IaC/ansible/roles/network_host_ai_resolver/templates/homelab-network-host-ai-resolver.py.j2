def load_json(path, default=None):
    if not path.exists():
        return default if default is not None else {}

    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise RuntimeError(f"Expected JSON object in {path}")
    return value


def save_atomic(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(
        dir=str(path.parent),
        prefix=f".{path.name}.",
    )
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def telemetry_hostname(hostname):
    """Map inventory FQDNs onto short host labels used by Prometheus/Loki."""
    value = str(hostname or "").strip()
    if value.lower().endswith(".jameshouse"):
        return value[:-11]
    return value


def canonical_estate_by_ip(estate):
    result = {}
    if not isinstance(estate, dict):
        return result
    for asset in estate.get("assets", []):
        if not isinstance(asset, dict) or asset.get("state") != "active":
            continue
        address = str(asset.get("address") or "").strip()
        if not address:
            continue
        result[address] = {
            "name": asset.get("name", ""),
            "document_label": asset.get("document_label", ""),
            "kind": asset.get("kind", ""),
            "role": asset.get("role", ""),
            "managed_by_ansible": bool(asset.get("managed_by_ansible", False)),
        }
    return result


def current_inventory_by_mac(inventory):
    current = {}
    for ip, entry in inventory.items():
        if not isinstance(entry, dict):
            continue
        mac = str(entry.get("mac") or "").strip().lower()
        if not mac:
            continue

        candidate = dict(entry)
        candidate["ip"] = str(entry.get("ip") or ip)
        existing = current.get(mac)

        if (
            existing is None
            or int(candidate.get("last_seen", 0) or 0)
            >= int(existing.get("last_seen", 0) or 0)
        ):
            current[mac] = candidate

    return current


def router_identity():
    result = {}
    if not ROUTER_DB.exists():
        return result

    uri = "file:" + str(ROUTER_DB) + "?mode=ro"
    con = sqlite3.connect(uri, uri=True, timeout=2)
    con.row_factory = sqlite3.Row
    try:
        rows = con.execute(
            """
            SELECT ip, mac, hostname, dhcp_hostname, online, last_seen
            FROM assets
            """
        ).fetchall()
    finally:
        con.close()

    for row in rows:
        mac = str(row["mac"] or "").strip().lower()
        if not mac:
            continue
        candidate = {
            "ip": str(row["ip"] or ""),
            "hostname": str(row["hostname"] or ""),
            "dhcp_hostname": str(row["dhcp_hostname"] or ""),
            "online": bool(row["online"]),
            "last_seen": int(row["last_seen"] or 0),
        }
        old = result.get(mac)
        if old is None or candidate["last_seen"] >= old["last_seen"]:
            result[mac] = candidate

    return result


def bounded_dns(record):
    if not isinstance(record, dict):
        return {}

    servers = []
    for server in record.get("servers", [])[:2]:
        if not isinstance(server, dict):
            continue
        servers.append({
            "server": server.get("server", ""),
            "signals": server.get("signals", [])[:5],
            "top_domains": server.get("top_domains", [])[:5],
        })

    return {
        "confidence": record.get("confidence", ""),
        "device_hint": record.get("device_hint", ""),
        "dns_hint": record.get("dns_hint", ""),
        "signal_ids": record.get("signal_ids", [])[:8],
        "servers": servers,
    }


def bounded_profile(record):
    if not isinstance(record, dict):
        return {}

    profile = record.get("profile", {})
    if not isinstance(profile, dict):
        profile = {}

    def side(name):
        value = profile.get(name, {})
        if not isinstance(value, dict):
            return {}
        return {
            "os_matches": value.get("os_matches", [])[:5],
            "ports": value.get("ports", [])[:20],
        }

    return {
        "status": record.get("status", ""),
        "needs_os_identification": bool(
            record.get("needs_os_identification", False)
        ),
        "last_error": record.get("last_error", ""),
        "vendor": record.get("vendor", ""),
        "hostname": record.get("hostname", ""),
        "tcp": side("tcp"),
        "udp": side("udp"),
    }


def bounded_enrichment(record):
    if not isinstance(record, dict):
        return {}
    return {
        "services": record.get("services", [])[:20],
        "tls_certificates": record.get("tls_certificates", [])[:5],
        "proxmox": record.get("proxmox"),
    }


def bounded_zeek(mac, zeek):
    devices = zeek.get("devices", {}) if isinstance(zeek, dict) else {}
    record = devices.get(mac, {}) if isinstance(devices, dict) else {}
    if not isinstance(record, dict):
        return {}
    return {
        "connections": record.get("connections", 0),
        "top_services": record.get("top_services", [])[:8],
        "top_ports": record.get("top_ports", [])[:8],
    }


def bounded_greenbone(ip, evidence):
    """Return only Greenbone evidence relevant to this current host IP."""
    if not isinstance(evidence, dict):
        return {"status": "unavailable"}

    collected_at = str(evidence.get("collected_at") or "")
    age_seconds = None
    if collected_at:
        try:
            from datetime import datetime, timezone
            stamp = datetime.fromisoformat(collected_at.replace("Z", "+00:00"))
            if stamp.tzinfo is not None:
                age_seconds = max(
                    0,
                    int((datetime.now(timezone.utc) -
                         stamp.astimezone(timezone.utc)).total_seconds()),
                )
        except (TypeError, ValueError):
            age_seconds = None

    status = "ok"
    if age_seconds is None:
        status = "undated"
    elif age_seconds > GREENBONE_FRESHNESS_SECONDS:
        status = "stale"

    findings = []
    for finding in evidence.get("actionable_findings", [])[:100]:
        if not isinstance(finding, dict):
            continue
        if str(finding.get("host") or "").strip() != ip:
            continue
        findings.append({
            "severity": finding.get("severity", ""),
            "score": finding.get("score"),
            "port": finding.get("port", ""),
            "name": finding.get("name", ""),
            "oid": finding.get("oid", ""),
            "cves": [
                str(value)[:32]
                for value in finding.get("cves", [])[:20]
                if value
            ],
        })

    return {
        "status": status,
        "report_id": evidence.get("report_id", ""),
        "task_name": evidence.get("task_name", ""),
        "collected_at": collected_at,
        "age_seconds": age_seconds,
        "matching_actionable_count": len(findings),
        "matching_actionable_findings": findings[:20],
        "interpretation_note": (
            "Only actionable findings matching this current IP are included. "
            "Zero matches is not proof that the host is vulnerability-free."
        ),
    }


def prometheus_query(expr):
    params = urllib.parse.urlencode({"query": expr})
    request = urllib.request.Request(
        PROMETHEUS_URL + "/api/v1/query?" + params,
        method="GET",
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        payload = json.loads(response.read().decode())
    if payload.get("status") != "success":
        raise RuntimeError("Prometheus query failed")
    return payload.get("data", {}).get("result", [])


def bounded_patch_status(hostname):
    """Return deterministic patch telemetry for a single managed host."""
    if not hostname:
        return {"status": "unavailable"}

    safe = hostname.replace("\\", "\\\\").replace('"', '\\"')
    queries = {
        "updates_available":
            'homelab_updates_available{target_name="' + safe + '"}',
        "security_updates_available":
            'homelab_security_updates_available{target_name="' + safe + '"}',
        "reboot_required":
            'homelab_reboot_required{target_name="' + safe + '"}',
        "unattended_upgrades_enabled":
            'homelab_unattended_upgrades_enabled{target_name="' + safe + '"}',
        "last_patch_success":
            'homelab_patch_last_success_timestamp_seconds{target_name="' + safe + '"}',
    }

    values = {}
    errors = []
    for name, expr in queries.items():
        try:
            results = prometheus_query(expr)
            if len(results) != 1:
                values[name] = None
                continue
            values[name] = float(results[0]["value"][1])
        except Exception as exc:
            values[name] = None
            errors.append(name + ": " + str(exc)[:160])

    last_success = values.get("last_patch_success")
    age_seconds = None
    freshness = "unavailable"
    if last_success is not None and last_success > 0:
        age_seconds = max(0, NOW - int(last_success))
        freshness = (
            "fresh"
            if age_seconds <= PATCH_FRESHNESS_SECONDS
            else "stale"
        )

    available = sum(1 for value in values.values() if value is not None)
    return {
        "status": "ok" if available else "unavailable",
        "updates_available": (
            int(values["updates_available"])
            if values["updates_available"] is not None else None
        ),
        "security_updates_available": (
            int(values["security_updates_available"])
            if values["security_updates_available"] is not None else None
        ),
        "reboot_required": (
            bool(int(values["reboot_required"]))
            if values["reboot_required"] is not None else None
        ),
        "unattended_upgrades_enabled": (
            bool(int(values["unattended_upgrades_enabled"]))
            if values["unattended_upgrades_enabled"] is not None else None
        ),
        "last_patch_success_timestamp": (
            int(last_success) if last_success is not None else None
        ),
        "last_patch_success_age_seconds": age_seconds,
        "freshness": freshness,
        "freshness_threshold_seconds": PATCH_FRESHNESS_SECONDS,
        "errors": errors,
        "interpretation_note": (
            "Patch telemetry is deterministic host evidence. Pending security "
            "updates may coexist with CVE findings, but this data does not "
            "prove that a specific package update fixes a specific CVE."
        ),
    }


def loki_query_range(selector, limit):
    end_ns = NOW * 1_000_000_000
    start_ns = (NOW - LOKI_WINDOW_HOURS * 3600) * 1_000_000_000
    params = urllib.parse.urlencode({
        "query": selector,
        "start": str(start_ns),
        "end": str(end_ns),
        "limit": str(limit),
        "direction": "backward",
    })
    request = urllib.request.Request(
        LOKI_URL + "/loki/api/v1/query_range?" + params,
        method="GET",
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        payload = json.loads(response.read().decode())
    if payload.get("status") != "success":
        raise RuntimeError("Loki query failed")
    return payload.get("data", {}).get("result", [])


def bounded_loki(hostname):
    """Return a 24h host-scoped Loki summary without exporting full raw logs."""
    if not hostname:
        return {"status": "unavailable", "window_hours": LOKI_WINDOW_HOURS}

    safe_host = hostname.replace("\\", "\\\\").replace('"', '\\"')
    selector = '{host="' + safe_host + '"}'
    try:
        streams = loki_query_range(selector, 5000)
    except Exception as exc:
        return {
            "status": "unavailable",
            "window_hours": LOKI_WINDOW_HOURS,
            "reason": str(exc)[:240],
        }

    total = 0
    jobs = {}
    samples = []
    seen_samples = set()
    sensitive = re.compile(
        r"(password|passwd|secret|token|api[_ -]?key|authorization|cookie|"
        r"session|private[_ -]?key|bearer\s+[a-z0-9._-]+)",
        re.IGNORECASE,
    )
    interesting = re.compile(
        r"(error|failed|failure|critical|warning|warn|denied|timeout|"
        r"unreachable|oom|segfault|panic)",
        re.IGNORECASE,
    )

    for stream in streams:
        labels = stream.get("stream", {})
        job = str(labels.get("job") or labels.get("source") or "unknown")
        values = stream.get("values", [])
        jobs[job] = jobs.get(job, 0) + len(values)
        total += len(values)
        for _stamp, line in values:
            text = str(line or "").strip()
            if not text or not interesting.search(text):
                continue
            if sensitive.search(text):
                text = "[redacted potentially sensitive log message]"
            text = re.sub(r"\b(?:\d{1,3}\.){3}\d{1,3}\b", "[ip]", text)
            text = re.sub(
                r"\b[0-9a-f]{2}(?::[0-9a-f]{2}){5}\b",
                "[mac]",
                text,
                flags=re.IGNORECASE,
            )
            text = text[:300]
            if text in seen_samples:
                continue
            seen_samples.add(text)
            samples.append(text)
            if len(samples) >= LOKI_SAMPLE_LIMIT:
                break
        if len(samples) >= LOKI_SAMPLE_LIMIT:
            break

    return {
        "status": "ok",
        "window_hours": LOKI_WINDOW_HOURS,
        "sampled_entries": total,
        "sampled_entries_by_job": dict(sorted(jobs.items())),
        "warning_error_samples": samples,
        "interpretation_note": (
            "This is a bounded 24-hour host-scoped Loki sample. Sampled "
            "entry counts are not complete 24-hour totals or incident counts. "
            "Samples are filtered/redacted and "
            "absence of warning/error text is not proof of health."
        ),
    }


def recent_dns_activity(ip):
    """Fetch bounded one-hour high-risk DNS policy matches from both resolvers."""
    if not ip:
        return {
            "status": "unavailable",
            "window_seconds": DNS_RECENT_WINDOW_SECONDS,
            "policy_matches": [],
        }

    combined = []
    sources = []
    errors = []

    for server in DNS_SERVERS:
        command = [
            "/usr/bin/ssh",
            "-T",
            "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=10",
            "-o", "StrictHostKeyChecking=yes",
            "-o", "UserKnownHostsFile=" + DNS_KNOWN_HOSTS,
            "-i", DNS_KEY,
            DNS_REMOTE_USER + "@" + server["address"],
            "recent", ip, str(DNS_RECENT_WINDOW_SECONDS),
        ]
        try:
            result = subprocess.run(
                command,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=30,
                check=False,
            )
            if result.returncode != 0:
                raise RuntimeError(result.stderr.strip()[:240])

            payload = json.loads(result.stdout)
            if payload.get("ip") != ip:
                raise RuntimeError("mismatched DNS client IP")
            if payload.get("server") != server["name"]:
                raise RuntimeError("unexpected DNS source")

            matches = payload.get("policy_matches", [])
            if not isinstance(matches, list):
                raise RuntimeError("invalid recent DNS policy response")

            sources.append(server["name"])
            for item in matches[:DNS_RECENT_REQUEST_LIMIT]:
                if not isinstance(item, dict):
                    continue
                domain = str(item.get("domain") or "").strip()
                timestamp = int(item.get("timestamp", 0) or 0)
                categories = [
                    str(value)[:64]
                    for value in item.get("categories", [])[:4]
                    if value
                ]
                if not domain or timestamp <= 0 or not categories:
                    continue
                combined.append({
                    "timestamp": timestamp,
                    "domain": domain[:255],
                    "categories": categories,
                    "server": server["name"],
                })
        except Exception as exc:
            errors.append(server["name"] + ": " + str(exc)[:200])

    unique = {}
    for item in combined:
        key = (
            item["timestamp"],
            item["domain"],
            tuple(item["categories"]),
        )
        unique.setdefault(key, item)

    matches = sorted(
        unique.values(),
        key=lambda item: item["timestamp"],
        reverse=True,
    )[:DNS_RECENT_REQUEST_LIMIT]

    return {
        "status": "ok" if sources else "unavailable",
        "window_seconds": DNS_RECENT_WINDOW_SECONDS,
        "sources": sources,
        "policy_matches": matches,
        "errors": errors,
        "interpretation_note": (
            "Only recent DNS attempts blocked by locally configured high-risk "
            "policy lists are included. Generic advertising/tracker blocks and "
            "ordinary DNS activity are excluded. A policy match is network "
            "evidence only and must not be treated as proof of user intent."
        ),
    }


def evidence_hash(value):
    payload = json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
    ).encode()
    return hashlib.sha256(payload).hexdigest()


def public_state(state):
    """Return the bounded documentation-safe projection of AI assessment state."""
    devices = {}
    for mac, record in state.get("devices", {}).items():
        if not isinstance(record, dict):
            continue
        result = record.get("result", {})
        if not isinstance(result, dict):
            result = {}
        devices[mac] = {
            "ip": record.get("ip", ""),
            "assessed_at": int(record.get("assessed_at", 0) or 0),
            "model": record.get("model", ""),
            "result": {
                "device_name": result.get("device_name", ""),
                "device_type": result.get("device_type", ""),
                "vendor": result.get("vendor", ""),
                "platform_family": result.get("platform_family", ""),
                "exact_os": result.get("exact_os", ""),
                "identity_confidence": result.get("identity_confidence", ""),
                "os_confidence": result.get("os_confidence", ""),
                "manual_review_required": bool(
                    result.get("manual_review_required", True)
                ),
                "summary": result.get("summary", ""),
                "confirmed_facts": result.get("confirmed_facts", [])[:20],
                "inferences": result.get("inferences", [])[:20],
                "evidence_summary": result.get("evidence_summary", [])[:20],
            },
        }
    return {
        "schema_version": 1,
        "generated_at": NOW,
        "model": state.get("model", MODEL),
        "devices": devices,
    }


def response_text(payload):
    for item in payload.get("output", []):
        if not isinstance(item, dict) or item.get("type") != "message":
            continue
        for part in item.get("content", []):
            if (
                isinstance(part, dict)
                and part.get("type") == "output_text"
                and isinstance(part.get("text"), str)
            ):
                return part["text"]
    raise RuntimeError("Responses API returned no output_text")


def ask_model(evidence):
    if not API_KEY:
        raise RuntimeError("OPENAI_API_KEY is not configured")

    schema = {
        "type": "object",
        "properties": {
            "device_name": {"type": "string"},
            "device_type": {"type": "string"},
            "vendor": {"type": "string"},
            "platform_family": {"type": "string"},
            "exact_os": {"type": "string"},
            "identity_confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"],
            },
            "os_confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"],
            },
            "manual_review_required": {"type": "boolean"},
            "summary": {"type": "string"},
            "confirmed_facts": {
                "type": "array",
                "items": {"type": "string"},
            },
            "inferences": {
                "type": "array",
                "items": {"type": "string"},
            },
            "evidence_summary": {
                "type": "array",
                "items": {"type": "string"},
            },
        },
        "required": [
            "device_name",
            "device_type",
            "vendor",
            "platform_family",
            "exact_os",
            "identity_confidence",
            "os_confidence",
            "manual_review_required",
            "summary",
            "confirmed_facts",
            "inferences",
            "evidence_summary",
        ],
        "additionalProperties": False,
    }

    system_text = (
        "Classify a home-network device from bounded technical evidence. "
        "Use only the supplied evidence. Do not invent a precise operating "
        "system or version. DHCP model-like hostnames, MAC vendor, Nmap "
        "fingerprints, open services and bounded DNS signals may support "
        "device identity. Treat lwIP as a TCP/IP stack, not a complete OS. "
        "If the exact OS is unsupported, return an empty exact_os string and "
        "use a cautious platform_family such as embedded IoT firmware. "
        "Separate confirmed facts from cautious inferences. Confirmed facts "
        "must be directly supported by supplied evidence. Never override a "
        "documented hostname, canonical estate role/kind, authoritative OS "
        "fact, or direct service fact "
        "with an inference. Treat Nmap service names as tentative labels unless "
        "corroborated by product/version or direct service evidence. Do not infer "
        "a host function from a port label alone. Greenbone findings are factual vulnerability "
        "evidence for the matching host IP only; absence of a matching finding "
        "is not proof that a host is secure or fully scanned. If CVE findings "
        "and pending security updates coexist, state only that both conditions "
        "merit review; do not claim a package fixes a specific CVE without "
        "explicit package-to-CVE evidence. Write a concise "
        "summary suitable for a Grafana host page. Set manual_review_required "
        "when identity or platform remains ambiguous."
    )

    request_body = {
        "model": MODEL,
        "store": False,
        "input": [
            {
                "role": "system",
                "content": system_text,
            },
            {
                "role": "user",
                "content": json.dumps(
                    evidence,
                    sort_keys=True,
                    separators=(",", ":"),
                ),
            },
        ],
        "text": {
            "format": {
                "type": "json_schema",
                "name": "network_device_identity",
                "strict": True,
                "schema": schema,
            }
        },
    }

    data = json.dumps(request_body).encode()
    request = urllib.request.Request(
        API_URL,
        data=data,
        headers={
            "Authorization": "Bearer " + API_KEY,
            "Content-Type": "application/json",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=90) as response:
            payload = json.loads(response.read().decode())
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")
        raise RuntimeError(
            f"Responses API HTTP {exc.code}: {body[:1000]}"
        ) from exc

    result = json.loads(response_text(payload))
    if not isinstance(result, dict):
        raise RuntimeError("Structured model result is not an object")
    return result


def main():
    inventory = load_json(INVENTORY)
    profiles_document = load_json(PROFILES)
    profiles = profiles_document.get("profiles", {})
    if not isinstance(profiles, dict):
        raise RuntimeError("deep-profiles.json lacks a profiles object")

    dns_devices = load_json(DNS, {}).get("devices", {})
    if not isinstance(dns_devices, dict):
        dns_devices = {}

    enrichment_hosts = load_json(ENRICHMENT, {}).get("hosts", {})
    if not isinstance(enrichment_hosts, dict):
        enrichment_hosts = {}

    zeek = load_json(OPTIONAL_ZEEK, {})
    greenbone = load_json(GREENBONE, {})
    estate = canonical_estate_by_ip(load_json(ESTATE, {}))
    routers = router_identity()
    current = current_inventory_by_mac(inventory)

    state = load_json(
        OUTPUT,
        {
            "schema_version": 1,
            "devices": {},
        },
    )
    state.setdefault("schema_version", 1)
    devices_state = state.setdefault("devices", {})
    if not isinstance(devices_state, dict):
        raise RuntimeError("AI resolver devices state is invalid")

    candidates = []

    for mac, inv in current.items():
        mac = str(mac).lower()
        if not isinstance(inv, dict):
            continue

        ip = str(inv.get("ip", ""))
        inventory_hostname = str(inv.get("hostname") or "")
        short_hostname = telemetry_hostname(inventory_hostname)
        if TARGET_HOSTNAME and TARGET_HOSTNAME not in {
            inventory_hostname,
            short_hostname,
        }:
            continue

        profile_record = profiles.get(mac, {})
        if not isinstance(profile_record, dict):
            profile_record = {}

        evidence = {
            "ip": ip,
            "mac": mac,
            "inventory": {
                "hostname": inventory_hostname,
                "telemetry_hostname": short_hostname,
                "vendor": inv.get("vendor", ""),
                "role": inv.get("role", ""),
                "kind": inv.get("kind", ""),
                "os": inv.get("os", ""),
                "os_source": inv.get("os_source", ""),
                "os_evidence": inv.get("os_evidence", ""),
                "architecture": inv.get("architecture", ""),
                "kernel": inv.get("kernel", ""),
                "first_seen": int(inv.get("first_seen", 0) or 0),
                "last_seen": int(inv.get("last_seen", 0) or 0),
                "online": bool(inv.get("online", False)),
            },
            "canonical_estate": estate.get(ip, {}),
            "router": routers.get(mac, {}),
            "nmap_profile": bounded_profile(profile_record),
            "dns": bounded_dns(dns_devices.get(mac, {})),
            "enrichment": bounded_enrichment(
                enrichment_hosts.get(ip, {})
            ),
            "zeek": bounded_zeek(mac, zeek),
            "greenbone": bounded_greenbone(ip, greenbone),
            "patching": bounded_patch_status(short_hostname),
            "loki": bounded_loki(short_hostname),
            "recent_dns_1h": recent_dns_activity(ip),
        }

        digest = evidence_hash(evidence)
        prior = devices_state.get(mac, {})
        if not isinstance(prior, dict):
            prior = {}
        prior_time = int(prior.get("assessed_at", 0) or 0)
        first_seen = int(inv.get("first_seen", 0) or 0)

        # Give a genuinely new device one hour for DNS, profiling and passive
        # evidence to settle before its first AI assessment.
        if (
            prior_time <= 0
            and first_seen > 0
            and NOW - first_seen < FIRST_ASSESSMENT_DELAY_SECONDS
        ):
            continue

        # Existing hosts refresh weekly. Rolling Loki (24h) and DNS (1h)
        # evidence naturally changes between hourly resolver runs and must not
        # turn the advisory AI layer into an hourly reassessment loop.
        if prior_time > 0 and NOW - prior_time < RETRY_SECONDS:
            continue

        # Unassessed devices take priority over routine weekly refreshes.
        # Among them, newer devices go first so a fresh arrival is not stuck
        # behind the existing estate during initial rollout.
        priority = (
            0 if prior_time <= 0 else 1,
            -first_seen if prior_time <= 0 else prior_time,
            ip,
        )
        candidates.append((priority, mac, ip, evidence, digest))

    candidates.sort(key=lambda item: item[0])

    processed = 0

    for _priority, mac, ip, evidence, digest in candidates[:MAX_DEVICES]:
        result = ask_model(evidence)
        prior = devices_state.get(mac, {})
        history = list(prior.get("history", [])) if isinstance(prior, dict) else []
        if isinstance(prior, dict) and prior.get("result"):
            history.append({
                "assessed_at": prior.get("assessed_at", 0),
                "model": prior.get("model", ""),
                "evidence_hash": prior.get("evidence_hash", ""),
                "result": prior.get("result", {}),
            })
        devices_state[mac] = {
            "ip": ip,
            "evidence_hash": digest,
            "assessed_at": NOW,
            "model": MODEL,
            "result": result,
            "history": history[-HISTORY_LIMIT:],
        }
        processed += 1
        print(json.dumps({
            "event": "network_host_ai_identification",
            "mac": mac,
            "ip": ip,
            "device_name": result.get("device_name", ""),
            "platform_family": result.get("platform_family", ""),
            "identity_confidence": result.get(
                "identity_confidence",
                "",
            ),
            "os_confidence": result.get("os_confidence", ""),
            "manual_review_required": result.get(
                "manual_review_required",
                True,
            ),
        }, sort_keys=True))

    state["last_run"] = NOW
    state["model"] = MODEL
    state["devices"] = devices_state
    save_atomic(OUTPUT, state)
    save_atomic(PUBLIC_OUTPUT, public_state(state))
    os.chmod(PUBLIC_OUTPUT, 0o644)

    print(json.dumps({
        "event": "network_host_ai_resolver_complete",
        "eligible": len(candidates),
        "processed": processed,
        "tracked": len(devices_state),
        "target_hostname": TARGET_HOSTNAME,
    }, sort_keys=True))


if __name__ == "__main__":
    main()
