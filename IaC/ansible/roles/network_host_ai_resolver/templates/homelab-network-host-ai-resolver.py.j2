#!/usr/bin/env python3

import hashlib
import json
import os
import sqlite3
import tempfile
import time
import urllib.error
import urllib.request
import urllib.parse
import re
from pathlib import Path

STATE_DIR = Path("{{ network_host_ai_resolver_state_dir }}")
INVENTORY = Path("{{ network_host_ai_resolver_inventory }}")
PROFILES = Path("{{ network_host_ai_resolver_profiles }}")
DNS = Path("{{ network_host_ai_resolver_dns }}")
ENRICHMENT = Path("{{ network_host_ai_resolver_enrichment }}")
ROUTER_DB = Path("{{ network_host_ai_resolver_router_db }}")
OPTIONAL_ZEEK = Path("{{ network_host_ai_resolver_optional_zeek }}")
GREENBONE = Path("{{ network_host_ai_resolver_greenbone }}")
GREENBONE_FRESHNESS_SECONDS = {{ network_host_ai_resolver_greenbone_freshness_seconds | int }}
LOKI_URL = "{{ network_host_ai_resolver_loki_url }}".rstrip("/")
LOKI_WINDOW_HOURS = {{ network_host_ai_resolver_loki_window_hours | int }}
LOKI_SAMPLE_LIMIT = {{ network_host_ai_resolver_loki_sample_limit | int }}
OUTPUT = Path("{{ network_host_ai_resolver_output }}")

MODEL = os.environ.get(
    "OPENAI_MODEL",
    "{{ network_host_ai_resolver_model }}",
).strip()
API_URL = os.environ.get(
    "OPENAI_RESPONSES_URL",
    "https://api.openai.com/v1/responses",
).strip()
API_KEY = os.environ.get("OPENAI_API_KEY", "").strip()

MAX_DEVICES = {{ network_host_ai_resolver_max_devices_per_run | int }}
RETRY_SECONDS = {{ network_host_ai_resolver_retry_seconds | int }}
FIRST_ASSESSMENT_DELAY_SECONDS = {{ network_host_ai_resolver_first_assessment_delay_seconds | int }}
HISTORY_LIMIT = {{ network_host_ai_resolver_history_limit | int }}
NOW = int(time.time())


def load_json(path, default=None):
    if not path.exists():
        return default if default is not None else {}

    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise RuntimeError(f"Expected JSON object in {path}")
    return value


def save_atomic(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(
        dir=str(path.parent),
        prefix=f".{path.name}.",
    )
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(value, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def current_inventory_by_mac(inventory):
    current = {}
    for ip, entry in inventory.items():
        if not isinstance(entry, dict):
            continue
        mac = str(entry.get("mac") or "").strip().lower()
        if not mac:
            continue

        candidate = dict(entry)
        candidate["ip"] = str(entry.get("ip") or ip)
        existing = current.get(mac)

        if (
            existing is None
            or int(candidate.get("last_seen", 0) or 0)
            >= int(existing.get("last_seen", 0) or 0)
        ):
            current[mac] = candidate

    return current


def router_identity():
    result = {}
    if not ROUTER_DB.exists():
        return result

    uri = "file:" + str(ROUTER_DB) + "?mode=ro"
    con = sqlite3.connect(uri, uri=True, timeout=2)
    con.row_factory = sqlite3.Row
    try:
        rows = con.execute(
            """
            SELECT ip, mac, hostname, dhcp_hostname, online, last_seen
            FROM assets
            """
        ).fetchall()
    finally:
        con.close()

    for row in rows:
        mac = str(row["mac"] or "").strip().lower()
        if not mac:
            continue
        candidate = {
            "ip": str(row["ip"] or ""),
            "hostname": str(row["hostname"] or ""),
            "dhcp_hostname": str(row["dhcp_hostname"] or ""),
            "online": bool(row["online"]),
            "last_seen": int(row["last_seen"] or 0),
        }
        old = result.get(mac)
        if old is None or candidate["last_seen"] >= old["last_seen"]:
            result[mac] = candidate

    return result


def bounded_dns(record):
    if not isinstance(record, dict):
        return {}

    servers = []
    for server in record.get("servers", [])[:2]:
        if not isinstance(server, dict):
            continue
        servers.append({
            "server": server.get("server", ""),
            "signals": server.get("signals", [])[:5],
            "top_domains": server.get("top_domains", [])[:5],
        })

    return {
        "confidence": record.get("confidence", ""),
        "device_hint": record.get("device_hint", ""),
        "dns_hint": record.get("dns_hint", ""),
        "signal_ids": record.get("signal_ids", [])[:8],
        "servers": servers,
    }


def bounded_profile(record):
    if not isinstance(record, dict):
        return {}

    profile = record.get("profile", {})
    if not isinstance(profile, dict):
        profile = {}

    def side(name):
        value = profile.get(name, {})
        if not isinstance(value, dict):
            return {}
        return {
            "os_matches": value.get("os_matches", [])[:5],
            "ports": value.get("ports", [])[:20],
        }

    return {
        "status": record.get("status", ""),
        "needs_os_identification": bool(
            record.get("needs_os_identification", False)
        ),
        "last_error": record.get("last_error", ""),
        "vendor": record.get("vendor", ""),
        "hostname": record.get("hostname", ""),
        "tcp": side("tcp"),
        "udp": side("udp"),
    }


def bounded_enrichment(record):
    if not isinstance(record, dict):
        return {}
    return {
        "services": record.get("services", [])[:20],
        "tls_certificates": record.get("tls_certificates", [])[:5],
        "proxmox": record.get("proxmox"),
    }


def bounded_zeek(mac, zeek):
    devices = zeek.get("devices", {}) if isinstance(zeek, dict) else {}
    record = devices.get(mac, {}) if isinstance(devices, dict) else {}
    if not isinstance(record, dict):
        return {}
    return {
        "connections": record.get("connections", 0),
        "top_services": record.get("top_services", [])[:8],
        "top_ports": record.get("top_ports", [])[:8],
    }


def bounded_greenbone(ip, evidence):
    """Return only Greenbone evidence relevant to this current host IP."""
    if not isinstance(evidence, dict):
        return {"status": "unavailable"}

    collected_at = str(evidence.get("collected_at") or "")
    age_seconds = None
    if collected_at:
        try:
            from datetime import datetime, timezone
            stamp = datetime.fromisoformat(collected_at.replace("Z", "+00:00"))
            if stamp.tzinfo is not None:
                age_seconds = max(
                    0,
                    int((datetime.now(timezone.utc) -
                         stamp.astimezone(timezone.utc)).total_seconds()),
                )
        except (TypeError, ValueError):
            age_seconds = None

    status = "ok"
    if age_seconds is None:
        status = "undated"
    elif age_seconds > GREENBONE_FRESHNESS_SECONDS:
        status = "stale"

    findings = []
    for finding in evidence.get("actionable_findings", [])[:100]:
        if not isinstance(finding, dict):
            continue
        if str(finding.get("host") or "").strip() != ip:
            continue
        findings.append({
            "severity": finding.get("severity", ""),
            "score": finding.get("score"),
            "port": finding.get("port", ""),
            "name": finding.get("name", ""),
            "oid": finding.get("oid", ""),
        })

    return {
        "status": status,
        "report_id": evidence.get("report_id", ""),
        "task_name": evidence.get("task_name", ""),
        "collected_at": collected_at,
        "age_seconds": age_seconds,
        "matching_actionable_count": len(findings),
        "matching_actionable_findings": findings[:20],
        "interpretation_note": (
            "Only actionable findings matching this current IP are included. "
            "Zero matches is not proof that the host is vulnerability-free."
        ),
    }


def loki_query_range(selector, limit):
    end_ns = NOW * 1_000_000_000
    start_ns = (NOW - LOKI_WINDOW_HOURS * 3600) * 1_000_000_000
    params = urllib.parse.urlencode({
        "query": selector,
        "start": str(start_ns),
        "end": str(end_ns),
        "limit": str(limit),
        "direction": "backward",
    })
    request = urllib.request.Request(
        LOKI_URL + "/loki/api/v1/query_range?" + params,
        method="GET",
    )
    with urllib.request.urlopen(request, timeout=20) as response:
        payload = json.loads(response.read().decode())
    if payload.get("status") != "success":
        raise RuntimeError("Loki query failed")
    return payload.get("data", {}).get("result", [])


def bounded_loki(hostname):
    """Return a 24h host-scoped Loki summary without exporting full raw logs."""
    if not hostname:
        return {"status": "unavailable", "window_hours": LOKI_WINDOW_HOURS}

    safe_host = hostname.replace("\\", "\\\\").replace('"', '\\"')
    selector = '{host="' + safe_host + '"}'
    try:
        streams = loki_query_range(selector, 5000)
    except Exception as exc:
        return {
            "status": "unavailable",
            "window_hours": LOKI_WINDOW_HOURS,
            "reason": str(exc)[:240],
        }

    total = 0
    jobs = {}
    samples = []
    seen_samples = set()
    sensitive = re.compile(
        r"(password|passwd|secret|token|api[_ -]?key|authorization|cookie|"
        r"session|private[_ -]?key|bearer\s+[a-z0-9._-]+)",
        re.IGNORECASE,
    )
    interesting = re.compile(
        r"(error|failed|failure|critical|warning|warn|denied|timeout|"
        r"unreachable|oom|segfault|panic)",
        re.IGNORECASE,
    )

    for stream in streams:
        labels = stream.get("stream", {})
        job = str(labels.get("job") or labels.get("source") or "unknown")
        values = stream.get("values", [])
        jobs[job] = jobs.get(job, 0) + len(values)
        total += len(values)
        for _stamp, line in values:
            text = str(line or "").strip()
            if not text or not interesting.search(text):
                continue
            if sensitive.search(text):
                text = "[redacted potentially sensitive log message]"
            text = re.sub(r"\b(?:\d{1,3}\.){3}\d{1,3}\b", "[ip]", text)
            text = re.sub(
                r"\b[0-9a-f]{2}(?::[0-9a-f]{2}){5}\b",
                "[mac]",
                text,
                flags=re.IGNORECASE,
            )
            text = text[:300]
            if text in seen_samples:
                continue
            seen_samples.add(text)
            samples.append(text)
            if len(samples) >= LOKI_SAMPLE_LIMIT:
                break
        if len(samples) >= LOKI_SAMPLE_LIMIT:
            break

    return {
        "status": "ok",
        "window_hours": LOKI_WINDOW_HOURS,
        "total_entries": total,
        "jobs": dict(sorted(jobs.items())),
        "warning_error_samples": samples,
        "interpretation_note": (
            "This is a bounded 24-hour host-scoped Loki sample. Counts are "
            "log entries, not incidents. Samples are filtered/redacted and "
            "absence of warning/error text is not proof of health."
        ),
    }


def evidence_hash(value):
    payload = json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
    ).encode()
    return hashlib.sha256(payload).hexdigest()


def response_text(payload):
    for item in payload.get("output", []):
        if not isinstance(item, dict) or item.get("type") != "message":
            continue
        for part in item.get("content", []):
            if (
                isinstance(part, dict)
                and part.get("type") == "output_text"
                and isinstance(part.get("text"), str)
            ):
                return part["text"]
    raise RuntimeError("Responses API returned no output_text")


def ask_model(evidence):
    if not API_KEY:
        raise RuntimeError("OPENAI_API_KEY is not configured")

    schema = {
        "type": "object",
        "properties": {
            "device_name": {"type": "string"},
            "device_type": {"type": "string"},
            "vendor": {"type": "string"},
            "platform_family": {"type": "string"},
            "exact_os": {"type": "string"},
            "identity_confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"],
            },
            "os_confidence": {
                "type": "string",
                "enum": ["high", "medium", "low"],
            },
            "manual_review_required": {"type": "boolean"},
            "summary": {"type": "string"},
            "confirmed_facts": {
                "type": "array",
                "items": {"type": "string"},
            },
            "inferences": {
                "type": "array",
                "items": {"type": "string"},
            },
            "evidence_summary": {
                "type": "array",
                "items": {"type": "string"},
            },
        },
        "required": [
            "device_name",
            "device_type",
            "vendor",
            "platform_family",
            "exact_os",
            "identity_confidence",
            "os_confidence",
            "manual_review_required",
            "summary",
            "confirmed_facts",
            "inferences",
            "evidence_summary",
        ],
        "additionalProperties": False,
    }

    system_text = (
        "Classify a home-network device from bounded technical evidence. "
        "Use only the supplied evidence. Do not invent a precise operating "
        "system or version. DHCP model-like hostnames, MAC vendor, Nmap "
        "fingerprints, open services and bounded DNS signals may support "
        "device identity. Treat lwIP as a TCP/IP stack, not a complete OS. "
        "If the exact OS is unsupported, return an empty exact_os string and "
        "use a cautious platform_family such as embedded IoT firmware. "
        "Separate confirmed facts from cautious inferences. Confirmed facts "
        "must be directly supported by supplied evidence. Never override a "
        "documented hostname, authoritative OS fact, or direct service fact "
        "with an inference. Greenbone findings are factual vulnerability "
        "evidence for the matching host IP only; absence of a matching finding "
        "is not proof that a host is secure or fully scanned. Write a concise "
        "summary suitable for a Grafana host page. Set manual_review_required "
        "when identity or platform remains ambiguous."
    )

    request_body = {
        "model": MODEL,
        "store": False,
        "input": [
            {
                "role": "system",
                "content": system_text,
            },
            {
                "role": "user",
                "content": json.dumps(
                    evidence,
                    sort_keys=True,
                    separators=(",", ":"),
                ),
            },
        ],
        "text": {
            "format": {
                "type": "json_schema",
                "name": "network_device_identity",
                "strict": True,
                "schema": schema,
            }
        },
    }

    data = json.dumps(request_body).encode()
    request = urllib.request.Request(
        API_URL,
        data=data,
        headers={
            "Authorization": "Bearer " + API_KEY,
            "Content-Type": "application/json",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(request, timeout=90) as response:
            payload = json.loads(response.read().decode())
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")
        raise RuntimeError(
            f"Responses API HTTP {exc.code}: {body[:1000]}"
        ) from exc

    result = json.loads(response_text(payload))
    if not isinstance(result, dict):
        raise RuntimeError("Structured model result is not an object")
    return result


def main():
    inventory = load_json(INVENTORY)
    profiles_document = load_json(PROFILES)
    profiles = profiles_document.get("profiles", {})
    if not isinstance(profiles, dict):
        raise RuntimeError("deep-profiles.json lacks a profiles object")

    dns_devices = load_json(DNS, {}).get("devices", {})
    if not isinstance(dns_devices, dict):
        dns_devices = {}

    enrichment_hosts = load_json(ENRICHMENT, {}).get("hosts", {})
    if not isinstance(enrichment_hosts, dict):
        enrichment_hosts = {}

    zeek = load_json(OPTIONAL_ZEEK, {})
    greenbone = load_json(GREENBONE, {})
    routers = router_identity()
    current = current_inventory_by_mac(inventory)

    state = load_json(
        OUTPUT,
        {
            "schema_version": 1,
            "devices": {},
        },
    )
    state.setdefault("schema_version", 1)
    devices_state = state.setdefault("devices", {})
    if not isinstance(devices_state, dict):
        raise RuntimeError("AI resolver devices state is invalid")

    candidates = []

    for mac, inv in current.items():
        mac = str(mac).lower()
        if not isinstance(inv, dict):
            continue

        ip = str(inv.get("ip", ""))
        profile_record = profiles.get(mac, {})
        if not isinstance(profile_record, dict):
            profile_record = {}

        evidence = {
            "ip": ip,
            "mac": mac,
            "inventory": {
                "hostname": inv.get("hostname", ""),
                "vendor": inv.get("vendor", ""),
                "first_seen": int(inv.get("first_seen", 0) or 0),
                "last_seen": int(inv.get("last_seen", 0) or 0),
                "online": bool(inv.get("online", False)),
            },
            "router": routers.get(mac, {}),
            "nmap_profile": bounded_profile(profile_record),
            "dns": bounded_dns(dns_devices.get(mac, {})),
            "enrichment": bounded_enrichment(
                enrichment_hosts.get(ip, {})
            ),
            "zeek": bounded_zeek(mac, zeek),
            "greenbone": bounded_greenbone(ip, greenbone),
            "loki": bounded_loki(inv.get("hostname", "")),
        }

        digest = evidence_hash(evidence)
        prior = devices_state.get(mac, {})
        if not isinstance(prior, dict):
            prior = {}
        prior_hash = prior.get("evidence_hash", "")
        prior_time = int(prior.get("assessed_at", 0) or 0)
        first_seen = int(inv.get("first_seen", 0) or 0)

        # Give a genuinely new device one hour for DNS, profiling and passive
        # evidence to settle before its first AI assessment.
        if (
            prior_time <= 0
            and first_seen > 0
            and NOW - first_seen < FIRST_ASSESSMENT_DELAY_SECONDS
        ):
            continue

        # Reassess immediately when evidence changes; otherwise refresh weekly.
        if prior_hash == digest and prior_time > 0 and NOW - prior_time < RETRY_SECONDS:
            continue

        # Unassessed devices take priority over routine weekly refreshes.
        # Among them, newer devices go first so a fresh arrival is not stuck
        # behind the existing estate during initial rollout.
        priority = (
            0 if prior_time <= 0 else 1,
            -first_seen if prior_time <= 0 else prior_time,
            ip,
        )
        candidates.append((priority, mac, ip, evidence, digest))

    candidates.sort(key=lambda item: item[0])

    processed = 0

    for _priority, mac, ip, evidence, digest in candidates[:MAX_DEVICES]:
        result = ask_model(evidence)
        prior = devices_state.get(mac, {})
        history = list(prior.get("history", [])) if isinstance(prior, dict) else []
        if isinstance(prior, dict) and prior.get("result"):
            history.append({
                "assessed_at": prior.get("assessed_at", 0),
                "model": prior.get("model", ""),
                "evidence_hash": prior.get("evidence_hash", ""),
                "result": prior.get("result", {}),
            })
        devices_state[mac] = {
            "ip": ip,
            "evidence_hash": digest,
            "assessed_at": NOW,
            "model": MODEL,
            "result": result,
            "history": history[-HISTORY_LIMIT:],
        }
        processed += 1
        print(json.dumps({
            "event": "network_host_ai_identification",
            "mac": mac,
            "ip": ip,
            "device_name": result.get("device_name", ""),
            "platform_family": result.get("platform_family", ""),
            "identity_confidence": result.get(
                "identity_confidence",
                "",
            ),
            "os_confidence": result.get("os_confidence", ""),
            "manual_review_required": result.get(
                "manual_review_required",
                True,
            ),
        }, sort_keys=True))

    state["last_run"] = NOW
    state["model"] = MODEL
    state["devices"] = devices_state
    save_atomic(OUTPUT, state)

    print(json.dumps({
        "event": "network_host_ai_resolver_complete",
        "eligible": len(candidates),
        "processed": processed,
        "tracked": len(devices_state),
    }, sort_keys=True))


if __name__ == "__main__":
    main()
