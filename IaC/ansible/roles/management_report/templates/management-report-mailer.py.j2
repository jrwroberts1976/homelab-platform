#!/usr/bin/env python3

import smtplib
from email.message import EmailMessage
from pathlib import Path


REPORT = Path(
    "{{ management_report_output_directory }}/latest.txt"
)

AI_ENABLED = {{ 'True' if management_report_ai_enabled | bool else 'False' }}
AI_REPORT = Path("{{ management_report_ai_output_file }}")
AI_PREFIX = "AI Management Briefing (interpretation; verify against facts below)\n"
FACTUAL_HEADING = "\n\nVerified factual report\n=======================\n"

SMTP_HOST = "{{ management_report_mail_host }}"
SMTP_PORT = {{ management_report_mail_port }}
MAIL_FROM = "{{ management_report_mail_from }}"
MAIL_TO = "{{ management_report_mail_to }}"

SUBJECT = "Homelab Daily Management Report"


def main():
    if not REPORT.is_file():
        raise SystemExit(
            "Management report is missing: " + str(REPORT)
        )

    body = REPORT.read_text(encoding="utf-8")

    if not body.strip():
        raise SystemExit("Management report is empty")

    if AI_ENABLED and AI_REPORT.is_file():
        # Require exact factual bytes and a file created after the current renderer.
        # Reject previous-day AI text, partial files, and factual-only fallback.
        try:
            candidate = AI_REPORT.read_text(encoding="utf-8")
            if (
                AI_REPORT.stat().st_mtime_ns >= REPORT.stat().st_mtime_ns
                and candidate.startswith(AI_PREFIX)
                and candidate.endswith(FACTUAL_HEADING + body)
            ):
                body = candidate
                print("AI_BRIEFING_MAIL=INCLUDED")
            else:
                print("AI_BRIEFING_MAIL=FACTUAL_FALLBACK")
        except OSError:
            print("AI_BRIEFING_MAIL=FACTUAL_FALLBACK")

    message = EmailMessage()
    message["From"] = MAIL_FROM
    message["To"] = MAIL_TO
    message["Subject"] = SUBJECT
    message.set_content(body)

    with smtplib.SMTP(
        SMTP_HOST,
        SMTP_PORT,
        timeout=15,
    ) as smtp:
        smtp.send_message(message)

    print(
        "Management report sent to "
        + MAIL_TO
        + " via "
        + SMTP_HOST
        + ":"
        + str(SMTP_PORT)
    )


if __name__ == "__main__":
    main()
