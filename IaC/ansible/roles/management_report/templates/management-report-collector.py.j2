def prometheus_query(query):
    response = requests.get(
        f"{PROMETHEUS_URL}/api/v1/query",
        params={"query": query},
        timeout=15,
    )
    response.raise_for_status()

    payload = response.json()
    if payload.get("status") != "success":
        raise RuntimeError(f"Prometheus query failed: {query}")

    return payload["data"]["result"]


def alertmanager_alerts():
    response = requests.get(
        f"{ALERTMANAGER_URL}/api/v2/alerts",
        timeout=15,
    )
    response.raise_for_status()
    return response.json()


def loki_label_values(label, query=None):
    params = {"since": f"{LOKI_EVIDENCE_SECONDS}s"}
    if query:
        params["query"] = query

    response = requests.get(
        f"{LOKI_URL}/loki/api/v1/label/{label}/values",
        params=params,
        timeout=15,
    )
    response.raise_for_status()

    payload = response.json()
    if payload.get("status") != "success":
        raise RuntimeError(f"Loki label query failed: {label}")

    return sorted(payload["data"])



def zabbix_api(method, params):
    token = ZABBIX_TOKEN_FILE.read_text().strip()
    if not token:
        raise RuntimeError("Zabbix API token file is empty")

    response = requests.post(
        ZABBIX_URL,
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json-rpc",
        },
        json={
            "jsonrpc": "2.0",
            "method": method,
            "params": params,
            "id": 1,
        },
        timeout=15,
    )
    response.raise_for_status()

    payload = response.json()
    if "error" in payload:
        raise RuntimeError(
            f"Zabbix API {method} failed: {payload['error'].get('message', 'unknown error')}"
        )

    return payload["result"]


def by_target_name(results):
    values = {}

    for result in results:
        target = result["metric"].get("target_name")
        if not target:
            continue

        values[target] = float(result["value"][1])

    return values





def prometheus_scalar(results):
    if not isinstance(results, list) or len(results) != 1:
        return None

    try:
        return float(results[0]["value"][1])
    except (KeyError, IndexError, TypeError, ValueError):
        return None


def network_inventory_evidence(raw):
    source = (
        'Prometheus target_name="'
        + NETWORK_INVENTORY_TARGET
        + '" textfile="'
        + NETWORK_INVENTORY_TEXTFILE
        + '"'
    )

    inventory_total = prometheus_scalar(
        raw.get("network_inventory_total", [])
    )
    online_total = prometheus_scalar(
        raw.get("network_online_total", [])
    )
    first_seen_24h = prometheus_scalar(
        raw.get("network_first_seen_24h", [])
    )
    source_mtime = prometheus_scalar(
        raw.get("network_inventory_mtime", [])
    )

    values = (
        inventory_total,
        online_total,
        first_seen_24h,
        source_mtime,
    )

    if any(value is None for value in values):
        return {
            "status": "unavailable",
            "source": source,
            "reason": (
                "One or more required Prometheus network inventory "
                "metrics are absent"
            ),
            "freshness_threshold_seconds": (
                NETWORK_INVENTORY_FRESHNESS_SECONDS
            ),
        }

    collected_at = datetime.fromtimestamp(
        source_mtime,
        timezone.utc,
    ).isoformat()

    age_seconds = time.time() - source_mtime

    evidence = {
        "source": source,
        "collected_at": collected_at,
        "inventory_total": int(inventory_total),
        "currently_online": int(online_total),
        "first_seen_24h": int(first_seen_24h),
        "source_age_seconds": int(max(0, age_seconds)),
        "freshness_threshold_seconds": (
            NETWORK_INVENTORY_FRESHNESS_SECONDS
        ),
    }

    count_values = (
        inventory_total,
        online_total,
        first_seen_24h,
    )

    if (
        source_mtime <= 0
        or any(value < 0 for value in count_values)
        or any(not value.is_integer() for value in count_values)
    ):
        evidence["status"] = "invalid"
        evidence["reason"] = (
            "Network inventory metrics contain invalid count "
            "or timestamp values"
        )
        return evidence

    if age_seconds < -60:
        evidence["status"] = "invalid"
        evidence["reason"] = (
            "Network inventory source timestamp is unexpectedly "
            "in the future"
        )
        return evidence

    if online_total > inventory_total:
        evidence["status"] = "invalid"
        evidence["reason"] = (
            "Currently-online count exceeds retained inventory total"
        )
        return evidence

    if first_seen_24h > inventory_total:
        evidence["status"] = "invalid"
        evidence["reason"] = (
            "First-seen-in-24h count exceeds retained inventory total"
        )
        return evidence

    if age_seconds > NETWORK_INVENTORY_FRESHNESS_SECONDS:
        evidence["status"] = "stale"
        evidence["reason"] = (
            "Network inventory evidence exceeds freshness threshold"
        )
        return evidence

    evidence["status"] = "ok"
    return evidence


def sensor_evidence():
    base = {
        "source": str(SENSOR_EVIDENCE_FILE),
        "freshness_threshold_seconds": SENSOR_FRESHNESS_SECONDS,
    }

    if not SENSOR_EVIDENCE_FILE.is_file():
        return {
            **base,
            "status": "missing",
            "reason": "sensor-01 evidence file is missing",
        }

    try:
        payload = json.loads(
            SENSOR_EVIDENCE_FILE.read_text(encoding="utf-8")
        )
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        return {
            **base,
            "status": "invalid",
            "reason": f"Unable to read valid JSON: {exc}",
        }

    if not isinstance(payload, dict):
        return {
            **base,
            "status": "invalid",
            "reason": "sensor-01 evidence must be a JSON object",
        }

    required = {
        "schema_version",
        "sensor_host",
        "collected_at",
        "requested_window_hours",
        "coverage",
        "assurance_gaps",
        "suricata",
        "zeek",
    }

    missing = sorted(required - set(payload))
    if missing:
        return {
            **base,
            "status": "invalid",
            "reason": "Missing required fields: " + ", ".join(missing),
        }

    if payload["schema_version"] != 2:
        return {
            **base,
            "status": "invalid",
            "reason": (
                "Unsupported sensor schema_version: "
                f"{payload['schema_version']!r}"
            ),
        }

    if payload["sensor_host"] != "sensor-01":
        return {
            **base,
            "status": "invalid",
            "reason": (
                "Unexpected sensor_host: "
                f"{payload['sensor_host']!r}"
            ),
        }

    if payload["requested_window_hours"] != 24:
        return {
            **base,
            "status": "invalid",
            "reason": (
                "Unexpected requested_window_hours: "
                f"{payload['requested_window_hours']!r}"
            ),
        }

    try:
        evidence_time = datetime.fromisoformat(
            str(payload["collected_at"]).replace("Z", "+00:00")
        )
    except ValueError:
        return {
            **base,
            "status": "invalid",
            "reason": "collected_at is not a valid ISO-8601 timestamp",
        }

    if evidence_time.tzinfo is None:
        return {
            **base,
            "status": "invalid",
            "reason": "collected_at must include a timezone",
        }

    evidence_time = evidence_time.astimezone(timezone.utc)
    now = datetime.now(timezone.utc)
    age_seconds = (now - evidence_time).total_seconds()

    if age_seconds < -300:
        return {
            **base,
            "status": "invalid",
            "reason": "collected_at is unexpectedly in the future",
            "collected_at": payload["collected_at"],
            "age_seconds": age_seconds,
        }

    identity = {
        **base,
        "schema_version": payload["schema_version"],
        "sensor_host": payload["sensor_host"],
        "collected_at": payload["collected_at"],
        "age_seconds": max(0, age_seconds),
        "requested_window_hours": payload["requested_window_hours"],
    }

    if age_seconds > SENSOR_FRESHNESS_SECONDS:
        return {
            **identity,
            "status": "stale",
            "reason": "sensor-01 evidence exceeds freshness threshold",
        }

    coverage = payload["coverage"]
    assurance_gaps = payload["assurance_gaps"]
    suricata = payload["suricata"]
    zeek = payload["zeek"]

    if not isinstance(coverage, dict):
        return {
            **identity,
            "status": "invalid",
            "reason": "coverage must be an object",
        }

    if not isinstance(assurance_gaps, list):
        return {
            **identity,
            "status": "invalid",
            "reason": "assurance_gaps must be a list",
        }

    if not isinstance(suricata, dict) or not isinstance(zeek, dict):
        return {
            **identity,
            "status": "invalid",
            "reason": "suricata and zeek must be objects",
        }

    suricata_rolling = suricata.get("rolling")
    zeek_conn = zeek.get("conn")
    zeek_dns = zeek.get("dns")
    zeek_notice = zeek.get("notice")
    zeek_ssl = zeek.get("ssl")
    capture_health = payload.get("capture_health")


    if not isinstance(suricata_rolling, dict):
        return {
            **identity,
            "status": "invalid",
            "reason": "suricata.rolling must be an object",
        }

    for name, value in (
        ("zeek.conn", zeek_conn),
        ("zeek.dns", zeek_dns),
        ("zeek.notice", zeek_notice),
        ("zeek.ssl", zeek_ssl),
    ):
        if not isinstance(value, dict):
            return {
                **identity,
                "status": "invalid",
                "reason": name + " must be an object",
            }

    return {
        **identity,
        "status": "ok",
        "coverage": coverage,
        "assurance_gap_count": len(assurance_gaps),
        "assurance_gaps": assurance_gaps,
        "suricata": {
            "total": suricata_rolling.get("total"),
            "significant": suricata_rolling.get("significant"),
            "severity_counts": suricata_rolling.get(
                "severity_counts", {}
            ),
            "inbound_no_response": suricata_rolling.get(
                "inbound_no_response"
            ),
            "inbound_with_response": suricata_rolling.get(
                "inbound_with_response"
            ),
            "outbound": suricata_rolling.get("outbound"),
        },
        "zeek": {
            "conn_records": zeek_conn.get("record_count"),
            "dns_records": zeek_dns.get("record_count"),
            "notice_records": zeek_notice.get("record_count"),
            "ssl_records": zeek_ssl.get("record_count"),
            "notice_types": zeek_notice.get("notice_types", {}),
        },
        "capture_health": capture_health if isinstance(capture_health, dict) else None,
    }


def greenbone_evidence():
    base = {
        "source": str(GREENBONE_EVIDENCE_FILE),
        "freshness_threshold_seconds": GREENBONE_FRESHNESS_SECONDS,
    }

    if not GREENBONE_EVIDENCE_FILE.is_file():
        return {
            **base,
            "status": "missing",
            "reason": "Greenbone evidence file is missing",
        }

    try:
        payload = json.loads(
            GREENBONE_EVIDENCE_FILE.read_text(encoding="utf-8")
        )
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        return {
            **base,
            "status": "invalid",
            "reason": f"Unable to read valid JSON: {exc}",
        }

    if not isinstance(payload, dict):
        return {
            **base,
            "status": "invalid",
            "reason": "Greenbone evidence must be a JSON object",
        }

    required = {
        "schema_version",
        "mode",
        "task_name",
        "report_id",
        "collected_at",
        "severity_counts",
        "actionable_count",
        "actionable_findings",
        "accepted_risk_count",
    }

    missing = sorted(required - set(payload))
    if missing:
        return {
            **base,
            "status": "invalid",
            "reason": "Missing required fields: " + ", ".join(missing),
        }

    if payload["schema_version"] != 1:
        return {
            **base,
            "status": "invalid",
            "reason": (
                "Unsupported Greenbone schema_version: "
                f"{payload['schema_version']!r}"
            ),
        }

    if payload["mode"] != "managed":
        return {
            **base,
            "status": "invalid",
            "reason": (
                "Unexpected Greenbone evidence mode: "
                f"{payload['mode']!r}"
            ),
        }

    severity_counts = payload["severity_counts"]
    if not isinstance(severity_counts, dict):
        return {
            **base,
            "status": "invalid",
            "reason": "severity_counts must be an object",
        }

    required_severities = {
        "Critical",
        "High",
        "Medium",
        "Low",
        "Log",
    }

    missing_severities = sorted(
        required_severities - set(severity_counts)
    )

    if missing_severities:
        return {
            **base,
            "status": "invalid",
            "reason": (
                "Missing severity counts: "
                + ", ".join(missing_severities)
            ),
        }

    for severity in required_severities:
        value = severity_counts[severity]

        if (
            isinstance(value, bool)
            or not isinstance(value, int)
            or value < 0
        ):
            return {
                **base,
                "status": "invalid",
                "reason": (
                    f"Invalid {severity} severity count: {value!r}"
                ),
            }

    actionable_count = payload["actionable_count"]
    actionable_findings = payload["actionable_findings"]
    accepted_risk_count = payload["accepted_risk_count"]

    if (
        isinstance(actionable_count, bool)
        or not isinstance(actionable_count, int)
        or actionable_count < 0
    ):
        return {
            **base,
            "status": "invalid",
            "reason": "actionable_count must be a non-negative integer",
        }

    if not isinstance(actionable_findings, list):
        return {
            **base,
            "status": "invalid",
            "reason": "actionable_findings must be a list",
        }

    if actionable_count != len(actionable_findings):
        return {
            **base,
            "status": "invalid",
            "reason": (
                "actionable_count does not match "
                "actionable_findings length"
            ),
        }

    if (
        isinstance(accepted_risk_count, bool)
        or not isinstance(accepted_risk_count, int)
        or accepted_risk_count < 0
    ):
        return {
            **base,
            "status": "invalid",
            "reason": (
                "accepted_risk_count must be a non-negative integer"
            ),
        }

    try:
        evidence_time = datetime.fromisoformat(
            str(payload["collected_at"]).replace("Z", "+00:00")
        )
    except ValueError:
        return {
            **base,
            "status": "invalid",
            "reason": "collected_at is not a valid ISO-8601 timestamp",
        }

    if evidence_time.tzinfo is None:
        return {
            **base,
            "status": "invalid",
            "reason": "collected_at must include a timezone",
        }

    evidence_time = evidence_time.astimezone(timezone.utc)
    now = datetime.now(timezone.utc)
    age_seconds = (now - evidence_time).total_seconds()

    if age_seconds < -300:
        return {
            **base,
            "status": "invalid",
            "reason": "collected_at is unexpectedly in the future",
            "collected_at": payload["collected_at"],
            "age_seconds": age_seconds,
        }

    identity = {
        **base,
        "schema_version": payload["schema_version"],
        "mode": payload["mode"],
        "task_name": payload["task_name"],
        "report_id": payload["report_id"],
        "collected_at": payload["collected_at"],
        "age_seconds": max(0, age_seconds),
    }

    if age_seconds > GREENBONE_FRESHNESS_SECONDS:
        return {
            **identity,
            "status": "stale",
            "reason": (
                "Greenbone evidence exceeds freshness threshold"
            ),
        }

    return {
        **identity,
        "status": "ok",
        "severity_counts": severity_counts,
        "actionable_count": actionable_count,
        "actionable_findings": actionable_findings,
        "accepted_risk_count": accepted_risk_count,
    }



def pihole_evidence():
    """Privacy-safe Loki event counts; never fetch individual DNS queries."""
    hosts = {}
    for host in ("dns-01", "dns-02"):
        selector = '{job="pihole",source="pihole-event",hostname="' + host + '"}'
        host_data = {"status": "unavailable", "events_24h": None,
                     "gravity_block_events_24h": None, "recent_events_15m": None}
        try:
            for key, expression in (
                ("events_24h", "sum(count_over_time(" + selector + "[24h]))"),
                ("gravity_block_events_24h", "sum(count_over_time(" + selector + ' |= "gravity blocked"[24h]))'),
                ("recent_events_15m", "sum(count_over_time(" + selector + "[15m]))"),
            ):
                response = requests.get(
                    f"{LOKI_URL}/loki/api/v1/query",
                    params={"query": expression}, timeout=15,
                )
                response.raise_for_status()
                payload = response.json()
                if payload.get("status") != "success":
                    raise ValueError("Loki returned non-success status")
                results = payload.get("data", {}).get("result", [])
                if not results:
                    raise ValueError("No Loki data for " + key)
                value = float(results[0]["value"][1])
                if not value.is_integer() or value < 0:
                    raise ValueError("Invalid count for " + key)
                host_data[key] = int(value)
            host_data["status"] = (
                "ok" if host_data["recent_events_15m"] > 0 else "stale"
            )
        except (requests.RequestException, ValueError, KeyError, IndexError, TypeError) as exc:
            host_data["status"] = "unavailable"
            host_data["reason"] = str(exc)
        hosts[host] = host_data
    return {
        "source": "Loki pihole-event streams",
        "collected_at": datetime.now(timezone.utc).isoformat(),
        "window_hours": 24,
        "freshness_window_minutes": 15,
        "metric_note": "Log event counts, not unique DNS queries or Pi-hole API totals",
        "hosts": hosts,
        "status": "ok" if all(h["status"] == "ok" for h in hosts.values()) else "partial",
    }


def main():
    collected_at = datetime.now(timezone.utc).isoformat()

    raw = {
        name: prometheus_query(query)
        for name, query in QUERIES.items()
    }

    alertmanager_active_alerts = alertmanager_alerts()

    zabbix_groups = zabbix_api(
        "hostgroup.get",
        {
            "output": ["groupid", "name"],
            "filter": {"name": ["Homelab/Linux"]},
        },
    )
    if len(zabbix_groups) != 1:
        raise RuntimeError(
            f"Expected exactly one Zabbix Homelab/Linux group, found {len(zabbix_groups)}"
        )

    zabbix_group_id = zabbix_groups[0]["groupid"]
    zabbix_hosts = zabbix_api(
        "host.get",
        {
            "output": ["host"],
            "groupids": [zabbix_group_id],
            "sortfield": "host",
        },
    )
    zabbix_host_names = sorted(host["host"] for host in zabbix_hosts)

    zabbix_agent_ping_items = zabbix_api(
        "item.get",
        {
            "output": [
                "itemid",
                "type",
                "status",
                "state",
                "lastclock",
                "lastvalue",
                "error",
            ],
            "groupids": [zabbix_group_id],
            "filter": {"key_": ["agent.ping"]},
            "selectHosts": ["host"],
        },
    )

    zabbix_ping_by_host = {}

    for item in zabbix_agent_ping_items:
        hosts = item.get("hosts", [])
        if not isinstance(hosts, list) or len(hosts) != 1:
            continue

        host = hosts[0].get("host")
        if not host:
            continue

        zabbix_ping_by_host.setdefault(host, []).append(item)

    zabbix_availability = {}
    zabbix_now = int(time.time())

    for host in EXPECTED_HOSTS:
        items = zabbix_ping_by_host.get(host, [])

        result = {
            "available": False,
            "status": "unknown",
            "lastvalue": None,
            "age_seconds": None,
            "error": "",
        }

        if len(items) == 0:
            result["status"] = "missing_agent_ping_item"

        elif len(items) > 1:
            result["status"] = "duplicate_agent_ping_items"

        else:
            item = items[0]

            lastclock = int(item.get("lastclock") or 0)
            lastvalue = item.get("lastvalue")
            age_seconds = (
                zabbix_now - lastclock
                if lastclock > 0
                else None
            )

            result["lastvalue"] = lastvalue
            result["age_seconds"] = (
                max(0, age_seconds)
                if age_seconds is not None
                else None
            )
            result["error"] = str(item.get("error") or "")

            if item.get("status") != "0":
                result["status"] = "item_disabled"

            elif item.get("state") != "0":
                result["status"] = "not_supported"

            elif lastclock <= 0:
                result["status"] = "no_data"

            elif age_seconds < -60:
                result["status"] = "future_timestamp"

            elif age_seconds > ZABBIX_AGENT_PING_FRESHNESS_SECONDS:
                result["status"] = "stale"

            elif lastvalue != "1":
                result["status"] = "unavailable"

            else:
                result["status"] = "available"
                result["available"] = True

        zabbix_availability[host] = result

    zabbix_available_hosts = sorted(
        host
        for host, item in zabbix_availability.items()
        if item["available"]
    )

    zabbix_unavailable_hosts = sorted(
        host
        for host, item in zabbix_availability.items()
        if not item["available"]
    )

    zabbix_missing_hosts = sorted(
        set(EXPECTED_HOSTS) - set(zabbix_host_names)
    )
    zabbix_unexpected_hosts = sorted(
        set(zabbix_host_names) - set(EXPECTED_HOSTS)
    )

    zabbix_problems = zabbix_api(
        "problem.get",
        {
            "output": ["eventid", "objectid", "clock", "name", "severity"],
            "groupids": [zabbix_group_id],
            "sortfield": ["eventid"],
            "sortorder": "DESC",
        },
    )

    zabbix_trigger_ids = sorted(
        {problem["objectid"] for problem in zabbix_problems}
    )

    zabbix_triggers = []
    if zabbix_trigger_ids:
        zabbix_triggers = zabbix_api(
            "trigger.get",
            {
                "output": ["triggerid"],
                "triggerids": zabbix_trigger_ids,
                "selectHosts": ["host"],
            },
        )

    zabbix_trigger_hosts = {
        trigger["triggerid"]: sorted(
            host["host"] for host in trigger.get("hosts", [])
        )
        for trigger in zabbix_triggers
    }

    for problem in zabbix_problems:
        problem["hosts"] = zabbix_trigger_hosts.get(
            problem["objectid"], []
        )
        problem.pop("objectid", None)


    patch = {
        name: by_target_name(raw[name])
        for name in (
            "updates_available",
            "security_updates_available",
            "reboot_required",
            "unattended_upgrades_enabled",
            "patch_last_success",
        )
    }

    exporter_up = by_target_name(raw["node_exporter_up"])

    firing_alerts = [
        {
            "labels": result.get("metric", {}),
            "value": float(result["value"][1]),
        }
        for result in raw["firing_alerts"]
    ]

    now = time.time()
    patch_fresh_hosts = sum(
        1
        for timestamp in patch["patch_last_success"].values()
        if 0 <= now - timestamp <= PATCH_FRESHNESS_SECONDS
    )

    loki_hosts = loki_label_values("host")
    loki_jobs = {
        "systemd-journal": loki_label_values("host", '{job="systemd-journal"}'),
        "docker": loki_label_values("host", '{job="docker"}'),
        "network-security": loki_label_values("host", '{job="network-security"}'),
        "network-infrastructure": loki_label_values("host", '{job="network-infrastructure"}'),
    }

    loki_missing_hosts = sorted(set(EXPECTED_HOSTS) - set(loki_hosts))
    loki_unexpected_hosts = sorted(set(loki_hosts) - set(EXPECTED_HOSTS))
    host_names = sorted(set(exporter_up) | set(patch["updates_available"]) | set(patch["security_updates_available"]) | set(patch["reboot_required"]) | set(patch["unattended_upgrades_enabled"]) | set(patch["patch_last_success"]))
    prometheus_missing_hosts = sorted(set(EXPECTED_HOSTS) - set(host_names))
    prometheus_unexpected_hosts = sorted(set(host_names) - set(EXPECTED_HOSTS))


    evidence = {
        "schema_version": 1,
        "collected_at": collected_at,
        "greenbone": greenbone_evidence(),
        "network_inventory": network_inventory_evidence(raw),
        "network_sensor": sensor_evidence(),
        "pihole": pihole_evidence(),
        "loki": {
            "evidence_window_hours": {{ management_report_evidence_hours }},
            "expected_hosts": EXPECTED_HOST_COUNT,
            "reporting_hosts": len(loki_hosts),
            "missing_hosts": loki_missing_hosts,
            "unexpected_hosts": loki_unexpected_hosts,
            "hosts": loki_hosts,
            "jobs": loki_jobs,
        },
        "alertmanager": {
            "active_alert_count": len(alertmanager_active_alerts),
            "active_alerts": alertmanager_active_alerts,
        },
        "zabbix": {
            "group_name": "Homelab/Linux",
            "expected_hosts": EXPECTED_HOST_COUNT,
            "reporting_hosts": len(zabbix_host_names),
            "missing_hosts": zabbix_missing_hosts,
            "unexpected_hosts": zabbix_unexpected_hosts,
            "hosts": zabbix_host_names,
            "agent_ping_freshness_threshold_seconds": ZABBIX_AGENT_PING_FRESHNESS_SECONDS,
            "available_hosts": len(zabbix_available_hosts),
            "unavailable_hosts": zabbix_unavailable_hosts,
            "availability": zabbix_availability,
            "active_problem_count": len(zabbix_problems),
            "active_problems": zabbix_problems,
        },
        "prometheus": {
            "expected_hosts": EXPECTED_HOST_COUNT,
            "firing_alert_count": len(firing_alerts),
            "firing_alerts": firing_alerts,
            "node_exporter_reporting_hosts": len(exporter_up),
            "missing_hosts": prometheus_missing_hosts,
            "unexpected_hosts": prometheus_unexpected_hosts,
            "node_exporter_up_hosts": sum(
                1 for value in exporter_up.values() if value == 1
            ),
            "patch_reporting_hosts": len(patch["patch_last_success"]),
            "patch_fresh_hosts": patch_fresh_hosts,
            "patch_freshness_threshold_seconds": PATCH_FRESHNESS_SECONDS,
            "hosts": {},
        },
    }

    for host in host_names:
        evidence["prometheus"]["hosts"][host] = {
            "node_exporter_up": exporter_up.get(host),
            "updates_available": patch["updates_available"].get(host),
            "security_updates_available": patch[
                "security_updates_available"
            ].get(host),
            "reboot_required": patch["reboot_required"].get(host),
            "unattended_upgrades_enabled": patch[
                "unattended_upgrades_enabled"
            ].get(host),
            "patch_last_success_timestamp_seconds": patch[
                "patch_last_success"
            ].get(host),
        }

    OUTPUT_FILE.parent.mkdir(parents=True, exist_ok=True)

    temporary = OUTPUT_FILE.with_suffix(".tmp")
    temporary.write_text(
        json.dumps(evidence, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    temporary.replace(OUTPUT_FILE)


if __name__ == "__main__":
    main()
