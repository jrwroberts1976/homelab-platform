#!/usr/bin/env python3

import json
import os
import socket
import subprocess
import tempfile
import time
import xml.etree.ElementTree as ET
from pathlib import Path

SUBNET = "{{ network_host_collector_subnet }}"
INTERFACE = "{{ network_host_collector_interface }}"

CANONICAL_HOSTNAMES = {{ network_host_collector_canonical_hostnames | to_json }}

STATE_FILE = Path("{{ network_host_collector_inventory }}")
EVENT_FILE = Path("{{ network_host_collector_events }}")
METRIC_FILE = Path("{{ network_host_collector_metrics }}")
ROUTER_HOSTNAME_SNAPSHOT = Path(
    "{{ network_host_collector_router_hostname_snapshot }}"
)

OFFLINE_AFTER = {{ network_host_collector_offline_after_seconds }}

NOW = int(time.time())


def run(cmd):
    return subprocess.run(
        cmd,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    ).stdout


def reverse_dns(ip):
    try:
        result = subprocess.run(
            ["getent", "hosts", ip],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        )

        if result.returncode != 0 or not result.stdout.strip():
            return ""

        fields = result.stdout.split()
        return fields[1] if len(fields) >= 2 else ""

    except Exception:
        return ""


def local_interface_identity():
    """Return the collector host's IPv4 and MAC on the scan interface.

    Nmap does not reliably report the address assigned to the interface it is
    scanning from, so the collector must explicitly include itself.
    """
    payload = json.loads(
        run([
            "ip",
            "-j",
            "addr",
            "show",
            "dev",
            INTERFACE,
        ])
    )

    if not payload:
        return "", ""

    interface = payload[0]
    mac = str(interface.get("address") or "").strip().lower()

    for address in interface.get("addr_info", []):
        if (
            address.get("family") == "inet"
            and address.get("scope") == "global"
            and address.get("local")
        ):
            return str(address["local"]).strip(), mac

    return "", mac


def load_asus_hostnames():
    """Load bounded DHCP hostname evidence from the ASUS snapshot.

    The ASUS collector publishes this file atomically after completing its
    router/DHCP inventory pass. Discovery never opens the live SQLite/WAL
    database, avoiding cross-service locking and systemd sandbox issues.
    """
    if not ROUTER_HOSTNAME_SNAPSHOT.exists():
        return {"by_mac": {}, "by_ip": {}}

    try:
        payload = json.loads(ROUTER_HOSTNAME_SNAPSHOT.read_text())
        if payload.get("schema_version") != 1:
            raise ValueError("unsupported router hostname snapshot schema")

        devices = payload.get("devices", {})
        if not isinstance(devices, dict):
            raise ValueError("router hostname snapshot devices is not an object")

        by_mac = {}
        by_ip = {}

        for mac, row in devices.items():
            if not isinstance(row, dict):
                continue

            mac = str(mac or "").strip().lower()
            ip = str(row.get("ip") or "").strip()
            hostname = str(
                row.get("dhcp_hostname")
                or row.get("hostname")
                or ""
            ).strip()
            last_seen = int(row.get("last_seen", 0) or 0)

            if not hostname:
                continue

            candidate = {
                "hostname": hostname,
                "last_seen": last_seen,
            }

            if mac:
                by_mac[mac] = candidate
            if ip:
                by_ip[ip] = candidate

        return {"by_mac": by_mac, "by_ip": by_ip}

    except Exception as exc:
        emit_event({
            "event": "router_hostname_evidence_unavailable",
            "error": str(exc),
        })
        return {"by_mac": {}, "by_ip": {}}

def router_hostname(router_names, ip, mac):
    if mac:
        candidate = router_names["by_mac"].get(mac.lower())
        if candidate and candidate.get("hostname"):
            return candidate["hostname"]

    candidate = router_names["by_ip"].get(ip)
    if candidate and candidate.get("hostname"):
        return candidate["hostname"]

    return ""


def load_state():
    if not STATE_FILE.exists():
        return {}

    try:
        data = json.loads(STATE_FILE.read_text())
    except Exception as exc:
        raise RuntimeError(
            f"Refusing to overwrite unreadable inventory: {STATE_FILE}"
        ) from exc

    if not isinstance(data, dict):
        raise RuntimeError(
            f"Refusing to overwrite invalid inventory structure: {STATE_FILE}"
        )

    return data


def save_atomic(path, text, mode):
    path.parent.mkdir(parents=True, exist_ok=True)

    fd, tmp = tempfile.mkstemp(
        dir=str(path.parent),
        prefix=f".{path.name}.",
    )

    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())

        os.chmod(tmp, mode)
        os.replace(tmp, path)

    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def emit_event(event):
    EVENT_FILE.parent.mkdir(parents=True, exist_ok=True)

    payload = {
        "timestamp": NOW,
        **event,
    }

    line = json.dumps(
        payload,
        sort_keys=True,
        separators=(",", ":"),
    )

    with EVENT_FILE.open("a") as fh:
        fh.write(line + "\n")

    # systemd journal -> existing Alloy -> Loki
    print(line, flush=True)


def scan(router_names):
    xml = run([
        "nmap",
        "-sn",
        "-n",
        "-e",
        INTERFACE,
        "-oX",
        "-",
        SUBNET,
    ])

    root = ET.fromstring(xml)
    found = {}

    for host in root.findall("host"):
        status = host.find("status")

        if status is None or status.get("state") != "up":
            continue

        ip = ""
        mac = ""
        vendor = ""

        for address in host.findall("address"):
            atype = address.get("addrtype")

            if atype == "ipv4":
                ip = address.get("addr", "")

            elif atype == "mac":
                mac = address.get("addr", "").lower()
                vendor = address.get("vendor", "")

        if not ip:
            continue

        times = host.find("times")
        latency_ms = None

        if times is not None and times.get("srtt"):
            try:
                latency_ms = round(
                    int(times.get("srtt")) / 1000.0,
                    3,
                )
            except Exception:
                pass

        hostname = CANONICAL_HOSTNAMES.get(ip, "")
        if not hostname:
            hostname = reverse_dns(ip)
        if not hostname:
            hostname = router_hostname(
                router_names,
                ip,
                mac,
            )

        found[ip] = {
            "ip": ip,
            "mac": mac,
            "vendor": vendor,
            "hostname": hostname,
            "latency_ms": latency_ms,
        }

    # Nmap can omit the scanner's own interface address from a ping scan.
    # Explicitly add the local interface so this host cannot age out of the
    # inventory and be incorrectly marked offline.
    try:
        local_ip, local_mac = local_interface_identity()

        if local_ip:
            existing = found.get(local_ip, {})
            local_hostname = (
                CANONICAL_HOSTNAMES.get(local_ip, "")
                or reverse_dns(local_ip)
                or socket.gethostname()
            )

            found[local_ip] = {
                "ip": local_ip,
                "mac": local_mac or existing.get("mac", ""),
                "vendor": existing.get("vendor", ""),
                "hostname": local_hostname,
                "latency_ms": 0.0,
            }

    except Exception as exc:
        emit_event({
            "event": "local_interface_identity_unavailable",
            "interface": INTERFACE,
            "error": str(exc),
        })

    return found


previous = load_state()
router_names = load_asus_hostnames()
current_scan = scan(router_names)

inventory = dict(previous)

for ip, discovered in current_scan.items():
    old = previous.get(ip)

    if old is None:
        inventory[ip] = {
            **discovered,
            "first_seen": NOW,
            "last_seen": NOW,
            "online": True,
        }

        emit_event({
            "event": "host_discovered",
            **inventory[ip],
        })

        continue

    entry = dict(old)

    changes = {}

    for field in (
        "mac",
        "vendor",
        "hostname",
    ):
        old_value = entry.get(field, "")
        new_value = discovered.get(field, "")

        if new_value and old_value != new_value:
            changes[field] = {
                "old": old_value,
                "new": new_value,
            }

            entry[field] = new_value

    entry["latency_ms"] = discovered.get("latency_ms")
    entry["last_seen"] = NOW

    was_online = bool(entry.get("online", False))
    entry["online"] = True

    inventory[ip] = entry

    if not was_online:
        emit_event({
            "event": "host_online",
            **entry,
        })

    if changes:
        emit_event({
            "event": "host_identity_changed",
            "ip": ip,
            "changes": changes,
        })


for ip, old in previous.items():
    if ip in current_scan:
        continue

    entry = dict(old)

    age = NOW - int(entry.get("last_seen", 0) or 0)

    if (
        entry.get("online", False)
        and age >= OFFLINE_AFTER
    ):
        entry["online"] = False

        emit_event({
            "event": "host_offline",
            **entry,
            "seconds_since_last_seen": age,
        })

    inventory[ip] = entry


save_atomic(
    STATE_FILE,
    json.dumps(
        inventory,
        indent=2,
        sort_keys=True,
    ) + "\n",
    0o600,
)


def esc(value):
    return (
        str(value)
        .replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", " ")
    )


metrics = [
    "# HELP homelab_network_host_info Static and discovered identity information for a network host.",
    "# TYPE homelab_network_host_info gauge",
    "# HELP homelab_network_host_up Whether the network host is currently considered online.",
    "# TYPE homelab_network_host_up gauge",
    "# HELP homelab_network_host_last_seen_seconds Unix timestamp when the network host was last observed.",
    "# TYPE homelab_network_host_last_seen_seconds gauge",
    "# HELP homelab_network_host_first_seen_seconds Unix timestamp when the network host was first observed.",
    "# TYPE homelab_network_host_first_seen_seconds gauge",
    "# HELP homelab_network_host_latency_milliseconds Last observed discovery latency.",
    "# TYPE homelab_network_host_latency_milliseconds gauge",
    "# HELP homelab_network_host_inventory_total Total hosts retained in the network inventory.",
    "# TYPE homelab_network_host_inventory_total gauge",
]

for ip in sorted(inventory):
    host = inventory[ip]

    base_labels = f'ip="{esc(ip)}"'

    info_labels = (
        f'ip="{esc(ip)}",'
        f'mac="{esc(host.get("mac", ""))}",'
        f'hostname="{esc(host.get("hostname", ""))}",'
        f'vendor="{esc(host.get("vendor", ""))}"'
    )

    metrics.append(
        'homelab_network_host_info{' + info_labels + '} 1'
    )

    metrics.append(
        'homelab_network_host_up{' + base_labels + '} '
        + str(1 if host.get("online") else 0)
    )

    metrics.append(
        'homelab_network_host_first_seen_seconds{' + base_labels + '} '
        + str(int(host.get("first_seen", 0) or 0))
    )

    metrics.append(
        'homelab_network_host_last_seen_seconds{' + base_labels + '} '
        + str(int(host.get("last_seen", 0) or 0))
    )

    latency = host.get("latency_ms")

    if latency is not None:
        metrics.append(
            'homelab_network_host_latency_milliseconds{' + base_labels + '} '
            + str(latency)
        )

metrics.append(
    f"homelab_network_host_inventory_total {len(inventory)}"
)

save_atomic(
    METRIC_FILE,
    "\n".join(metrics) + "\n",
    0o644,
)
