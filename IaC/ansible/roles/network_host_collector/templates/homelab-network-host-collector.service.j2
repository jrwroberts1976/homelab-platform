[Unit]
Description=Homelab Network Host Collector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
{% if network_host_collector_alert_enabled | bool %}
EnvironmentFile=-{{ network_host_collector_alert_environment }}
{% endif %}
ExecStart={{ network_host_collector_script }}
{% if network_host_collector_alert_enabled | bool %}
ExecStartPost=-{{ network_host_collector_alert_script }}
{% endif %}

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

ReadWritePaths={{ network_host_collector_state_dir }}
ReadWritePaths={{ network_host_collector_events_dir }}
ReadWritePaths={{ network_host_collector_textfile_dir }}

[Install]
WantedBy=multi-user.target
