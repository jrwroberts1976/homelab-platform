{
  "id": null,
  "uid": "homelab-mac-device-detail",
  "title": "Homelab — Host Detail",
  "description": "Per-host Grafana dashboard matching the Production Hosts layout, with OS evidence, open ports, DNS clues and Linux charts when available. Host selection by hostname.",
  "tags": [
    "homelab",
    "hosts",
    "network",
    "operating-system",
    "ports"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 8,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_card_info, hostname)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "monitor-01",
          "value": "monitor-01"
        },
        "sort": 1
      },
      {
        "name": "device",
        "label": "Internal device identity",
        "hide": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_card_info{hostname=\"$host\"}, device_key)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "sort": 1
      },
      {
        "name": "node_host",
        "label": "Linux metrics hostname",
        "hide": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_card_info{hostname=\"$host\"}, hostname)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Home",
      "type": "link",
      "url": "/d/homelab-operations",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Hosts",
      "type": "link",
      "url": "/d/homelab-network-host-tiles?var-host=$host",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
