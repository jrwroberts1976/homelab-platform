    {
      "id": 7,
      "type": "timeseries",
      "title": "Network Throughput",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (target_name) (rate(node_network_receive_bytes_total{target_name=\"$node_host\",device!~\"lo|veth.*|docker.*|br-.*|virbr.*|cni.*|flannel.*|tun.*|tap.*\"}[5m]))",
          "legendFormat": "{{target_name}} receive"
        },
        {
          "refId": "B",
          "expr": "sum by (target_name) (rate(node_network_transmit_bytes_total{target_name=\"$node_host\",device!~\"lo|veth.*|docker.*|br-.*|virbr.*|cni.*|flannel.*|tun.*|tap.*\"}[5m]))",
          "legendFormat": "{{target_name}} transmit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Inbound and outbound network throughput for the selected host, excluding loopback and virtual interfaces."
