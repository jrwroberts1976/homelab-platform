{
  "id": null,
  "uid": "homelab-router-dhcp",
  "title": "Homelab — Router DHCP Activity",
  "description": "DHCP events from router-01 dnsmasq via Alloy and Loki; logs can include client IPs, MAC addresses and hostnames.",
  "tags": [
    "homelab",
    "router",
    "dhcp",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "DHCP activity by event",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({host=\"router-01\",service=\"dnsmasq\"} |= \"DHCPDISCOVER\" [$__interval]))",
          "legendFormat": "DHCPDISCOVER",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({host=\"router-01\",service=\"dnsmasq\"} |= \"DHCPOFFER\" [$__interval]))",
          "legendFormat": "DHCPOFFER",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({host=\"router-01\",service=\"dnsmasq\"} |= \"DHCPREQUEST\" [$__interval]))",
          "legendFormat": "DHCPREQUEST",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "D",
          "expr": "sum(count_over_time({host=\"router-01\",service=\"dnsmasq\"} |= \"DHCPACK\" [$__interval]))",
          "legendFormat": "DHCPACK",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "E",
          "expr": "sum(count_over_time({host=\"router-01\",service=\"dnsmasq\"} |= \"DHCPNAK\" [$__interval]))",
          "legendFormat": "DHCPNAK",
          "queryType": "range",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "DHCP ACKs (last hour)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
