    {
      "id": 16,
      "title": "WAN probe failure rate — 15m",
      "description": "Percentage of failed 30-second ICMP checks over a rolling 15-minute window. This is probe failure rate, not packet-level loss measured by ping.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 43,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg_over_time(probe_success{job=\"blackbox-wan-icmp\"}[15m]))",
          "legendFormat": "{{target_name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
