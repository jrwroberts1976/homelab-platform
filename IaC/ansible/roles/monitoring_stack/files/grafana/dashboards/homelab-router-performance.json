{
  "id": null,
  "uid": "homelab-router-performance",
  "title": "Homelab — Router Performance & Security",
  "description": "Router-01 host metrics from existing private Prometheus node-exporter scrape. Interface state and drops are operational signals, not a substitute for security scanning. WAN latency and rolling ICMP probe failure rate use monitoring-server probes (not direct router probes).",
  "tags": [
    "homelab",
    "router",
    "prometheus",
    "performance"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter scrape healthy",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"router-node-exporter\"}",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto"
      }
    },
