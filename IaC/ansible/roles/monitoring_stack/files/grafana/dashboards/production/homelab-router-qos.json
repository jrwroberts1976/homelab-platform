{
  "id": null,
  "uid": "homelab-router-qos",
  "title": "Homelab \u2014 Router QoS",
  "description": "CAKE queue activity on router-01. Counters require textfile collector and Prometheus scrape; no data is not zero. Queue rates are CAKE accounting, not broadband speed tests. Overlimits are expected with shaping.",
  "tags": [
    "homelab",
    "router",
    "qos",
    "cake"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
