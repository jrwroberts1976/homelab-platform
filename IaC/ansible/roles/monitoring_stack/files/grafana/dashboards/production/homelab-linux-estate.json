    {
      "id": 28,
      "type": "timeseries",
      "title": "Network Throughput",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (target_name) (rate(node_network_receive_bytes_total{target_name=~\"$host\",device!~\"lo|veth.*|docker.*|br-.*|virbr.*|cni.*|flannel.*|tun.*|tap.*\"}[5m]))",
          "legendFormat": "{{target_name}} receive"
        },
        {
          "refId": "B",
          "expr": "sum by (target_name) (rate(node_network_transmit_bytes_total{target_name=~\"$host\",device!~\"lo|veth.*|docker.*|br-.*|virbr.*|cni.*|flannel.*|tun.*|tap.*\"}[5m]))",
          "legendFormat": "{{target_name}} transmit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Inbound and outbound network throughput for the selected host, excluding loopback and virtual interfaces."
    },
    {
      "id": 29,
      "type": "table",
      "title": "Operating System & Platform",
      "description": "Authoritative OS facts collected by Zabbix Agent 2 and published through the network inventory exporter.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_card_info{hostname=\"$host\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "target_name": true,
              "device_key": true,
              "mac": true,
              "dashboard_uid": true,
              "dns_hint": true,
              "dns_observed": true,
              "observed_open_ports": true,
              "status": true,
              "vendor": true,
              "role": true,
              "kind": true,
              "nmap_name": true,
              "nmap_accuracy": true,
              "nmap_family": true,
