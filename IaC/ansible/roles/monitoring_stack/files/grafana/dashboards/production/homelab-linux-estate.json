              "nmap_scanned_at": true,
              "nmap_time_basis": true,
              "nmap_services": true,
              "nmap_scan_status": true
            },
            "indexByName": {
              "hostname": 0,
              "ip": 1,
              "os": 2,
              "architecture": 3,
              "kernel": 4,
              "os_source": 5,
              "os_evidence": 6
            },
            "renameByName": {
              "hostname": "Host",
              "ip": "IP address",
              "os": "Operating system",
              "architecture": "Architecture",
              "kernel": "Kernel",
              "os_source": "OS source",
              "os_evidence": "Evidence"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": false
