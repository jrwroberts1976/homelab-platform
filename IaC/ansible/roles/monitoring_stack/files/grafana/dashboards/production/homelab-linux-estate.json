    },
    {
      "id": 30,
      "type": "table",
      "title": "Open Ports & Services",
      "description": "Current open TCP ports and service/version evidence from the targeted Nmap enrichment pipeline.",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (ip, port, protocol, service, product, version) (homelab_network_host_enrichment_port_info * on(ip) group_left(hostname) (homelab_network_device_card_info{hostname=\"$host\"} == 1))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
