      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_open_port_info{ip=\"$device\"}",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
