            "indexByName": {
              "protocol": 0,
              "port": 1,
              "service": 2,
              "product": 3,
              "version": 4,
              "source": 5,
              "observed": 6
            },
            "renameByName": {
              "protocol": "Protocol",
              "port": "Port",
              "service": "Service",
