              "os": 2,
              "os_evidence": 3,
              "os_source": 4,
              "dns_hint": 5,
              "dns_observed": 6,
              "observed_open_ports": 7
            },
            "renameByName": {
              "hostname": "Hostname",
              "ip": "IP",
              "os": "OS",
              "os_evidence": "Evidence level",
              "os_source": "Source",
              "dns_hint": "DNS observations",
              "dns_observed": "DNS evidence date",
              "observed_open_ports": "Open ports observed"
            }
          }
