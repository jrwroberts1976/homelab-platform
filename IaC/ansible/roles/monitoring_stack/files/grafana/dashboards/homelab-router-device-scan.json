{
  "id": null,
  "uid": "homelab-router-device-scan",
  "title": "Homelab — Device Scan Report",
  "description": "Actual Nmap evidence for devices with a completed or partial profiling scan.",
  "tags": [
    "homelab",
    "network",
    "device",
    "mac"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "2m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "mac",
        "label": "Device MAC Address",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_router_device_scan_state{status=~\"complete|partial\"}, mac)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Device Identity",
      "type": "link",
      "url": "/d/homelab-router-device-profile",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Device Inventory",
      "type": "link",
      "url": "/d/homelab-router-devices",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Scan Status",
      "description": "MAC-keyed DHCP identity. The OUI manufacturer identifies the network adapter, not necessarily the complete device. The IP address is the last recorded DHCP address.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_router_device_scan_state{mac=\"$mac\",status=~\"complete|partial\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Nmap OS Matches — Accuracy and Rank",
      "description": "Each result includes the TCP or UDP scan, Nmap match rank and reported accuracy. Accuracy is a similarity score, not the probability that the OS is correct.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_router_device_os_match_accuracy_percent{mac=\"$mac\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Discovered Ports and Services",
      "description": "TCP and UDP scan findings. A state of open|filtered is inconclusive and must not be treated as a confirmed open port.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_router_device_port_info{mac=\"$mac\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
