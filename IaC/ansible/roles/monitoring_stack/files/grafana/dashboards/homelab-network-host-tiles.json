{
  "id": null,
  "uid": "homelab-network-host-tiles",
  "title": "Homelab — Network Hosts",
  "description": "Compact hostname-first view showing only the available device identity, network status, OS and recorded port/DNS evidence. Full automatically generated profiles include only panels with real data.",
  "tags": [
    "homelab",
    "hosts",
    "network",
    "operating-system",
    "ports"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 6,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_card_info, hostname)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "monitor-01",
          "value": "monitor-01"
        },
        "sort": 1
      },
      {
        "name": "device",
        "label": "Internal device identity",
        "hide": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_card_info{hostname=\"$host\"}, device_key)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "sort": 1
      },
      {
        "name": "profile_uid",
        "label": "Host profile dashboard UID",
        "hide": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_card_info{hostname=\"$host\"}, dashboard_uid)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Home",
      "type": "link",
      "url": "/d/homelab-operations",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/homelab-observability",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Full Host Dashboard",
      "type": "link",
      "url": "/d/${profile_uid}",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "All Hosts",
      "type": "link",
      "url": "/d/homelab-network-host-tiles",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 9,
      "title": "Network status",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_card_online{device_key=\"$device\"}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "red"
                },
                "1": {
                  "text": "Online",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 14,
      "title": "Selected host — identity, OS and available evidence",
      "type": "table",
      "description": "A single host record; port and DNS evidence appear here when present. Detailed panels are generated only for hosts that have the relevant data.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_card_info{device_key=\"$device\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "target_name": true,
              "device_key": true,
              "mac": true,
              "dashboard_uid": true,
              "dns_hint": true,
              "dns_observed": true,
              "port": true,
              "protocol": true,
              "service": true,
              "product": true,
              "version": true,
              "source": true,
              "observed": true,
              "name": true,
              "pretty_name": true,
              "id": true,
              "vendor": true,
              "role": true,
              "kind": true
            },
            "indexByName": {
              "hostname": 0,
              "ip": 1,
              "status": 2,
              "os": 3,
              "os_evidence": 4,
              "observed_open_ports": 5,
              "dns_hint": 6,
              "os_source": 7
            },
            "renameByName": {
              "hostname": "Hostname",
              "ip": "IP address",
              "status": "Presence",
              "os": "OS",
              "os_evidence": "OS evidence",
              "observed_open_ports": "Observed open ports",
              "dns_hint": "DNS clues",
              "os_source": "Evidence source"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true
      }
    },
    {
      "id": 18,
      "title": "Network directory — choose a hostname",
      "type": "table",
      "description": "Select a hostname from the top dropdown, then use Open full host dashboard to see only panels supported by its actual data.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_card_info",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "target_name": true,
              "device_key": true,
              "mac": true,
              "dashboard_uid": true,
              "vendor": true,
              "role": true,
              "os_source": true,
              "dns_hint": true,
              "dns_observed": true,
              "port": true,
              "protocol": true,
              "service": true,
              "product": true,
              "version": true,
              "source": true,
              "observed": true,
              "name": true,
              "pretty_name": true,
              "id": true,
              "kind": true,
              "os_evidence": true
            },
            "indexByName": {
              "hostname": 0,
              "ip": 1,
              "status": 2,
              "os": 3,
              "observed_open_ports": 4
            },
            "renameByName": {
              "hostname": "Hostname",
              "ip": "IP address",
              "status": "Presence",
              "os": "OS",
              "observed_open_ports": "Observed open ports"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hostname"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "View host profile",
                    "url": "/d/homelab-mac-device-detail?var-host=${__data.fields[\"Hostname\"]}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true
      }
    }
  ]
}
