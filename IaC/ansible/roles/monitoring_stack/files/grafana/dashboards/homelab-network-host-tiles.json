{
  "id": null,
  "uid": "homelab-network-host-tiles",
  "title": "Homelab — Network Hosts",
  "description": "Rebuilt from the legacy Network Discovery design: hostname directory, estate counters and direct links to independently generated per-device dashboards. Linux graphs appear only on hosts with recorded Linux metrics.",
  "tags": [
    "homelab",
    "hosts",
    "network",
    "operating-system",
    "ports"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 9,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_card_info, hostname)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": true,
          "text": "monitor-01",
          "value": "monitor-01"
        },
        "sort": 1
      },
      {
        "name": "device",
        "label": "Internal device identity",
        "hide": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_card_info{hostname=\"$host\"}, device_key)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "sort": 1
      },
      {
        "name": "profile_uid",
        "label": "Host profile dashboard UID",
        "hide": 2,
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_card_info{hostname=\"$host\"}, dashboard_uid)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {
          "selected": false,
          "text": "",
          "value": ""
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Home",
      "type": "link",
      "url": "/d/homelab-operations",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Logs",
      "type": "link",
      "url": "/d/homelab-observability",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Choose host dashboard",
      "type": "dashboards",
      "tags": [
        "generated-network-host"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    },
    {
      "title": "Individual hosts",
      "type": "dashboards",
      "tags": [
        "generated-network-host"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 101,
      "title": "Known devices",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(homelab_network_device_card_info)",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 102,
      "title": "Online",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(homelab_network_device_card_online == 1) or vector(0)",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 103,
      "title": "Documented OS",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(homelab_network_device_card_info{os_evidence=\"documented\"}) or vector(0)",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 104,
      "title": "OS to investigate",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(homelab_network_device_card_info{os_evidence=~\"unknown|inferred_.*\"}) or vector(0)",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "Selected host — presence",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_card_online{device_key=\"$device\"}",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unknown",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "red"
                },
                "1": {
                  "text": "Online",
                  "color": "green"
                },
                "-1": {
                  "text": "Unknown",
                  "color": "gray"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 14,
      "title": "Selected host — OS, observed ports and DNS clues",
      "type": "table",
      "description": "Evidence for the selected hostname. The individual dashboard contains *only* panels backed by observations; there are no empty Linux graphs on a router.",
      "gridPos": {
        "x": 5,
        "y": 4,
        "w": 19,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_card_info{device_key=\"$device\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "target_name": true,
              "device_key": true,
              "mac": true,
              "dashboard_uid": true,
              "port": true,
              "protocol": true,
              "service": true,
              "product": true,
              "version": true,
              "source": true,
              "observed": true,
              "name": true,
              "pretty_name": true,
              "id": true,
              "role": true,
              "nmap_name": true,
              "nmap_accuracy": true,
              "nmap_family": true,
              "nmap_generation": true,
              "nmap_vendor": true,
              "nmap_device_type": true,
              "nmap_cpe": true,
              "nmap_scanned_at": true,
              "nmap_services": true,
              "nmap_scan_status": true,
              "nmap_time_basis": true
            },
            "indexByName": {
              "hostname": 0,
              "ip": 1,
              "status": 2,
              "kind": 3,
              "vendor": 4,
              "os": 5,
              "os_evidence": 6,
              "os_source": 7,
              "observed_open_ports": 8,
              "dns_hint": 9,
              "dns_observed": 10
            },
            "renameByName": {
              "hostname": "Hostname",
              "ip": "Current IP",
              "status": "Presence",
              "kind": "Type",
              "vendor": "Vendor",
              "os": "Operating system",
              "os_evidence": "OS evidence",
              "os_source": "Evidence source",
              "observed_open_ports": "Observed open ports",
              "dns_hint": "DNS clues",
              "dns_observed": "DNS date"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true
      }
    },
    {
      "id": 18,
      "title": "Network hosts — select a hostname and open its dedicated dashboard",
      "type": "table",
      "description": "One row per known device. Click Open host to navigate directly to that device's own data-only Grafana dashboard. Hostnames are displayed; MAC addresses remain internal identifiers.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 17
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "homelab_network_device_card_info",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "target_name": true,
              "device_key": true,
              "mac": true,
              "vendor": true,
              "role": true,
              "os_source": true,
              "dns_hint": true,
              "dns_observed": true,
              "port": true,
              "protocol": true,
              "service": true,
              "product": true,
              "version": true,
              "source": true,
              "observed": true,
              "name": true,
              "pretty_name": true,
              "id": true,
              "kind": true,
              "os_evidence": true,
              "nmap_name": true,
              "nmap_accuracy": true,
              "nmap_family": true,
              "nmap_generation": true,
              "nmap_vendor": true,
              "nmap_device_type": true,
              "nmap_cpe": true,
              "nmap_scanned_at": true,
              "nmap_services": true,
              "nmap_scan_status": true,
              "nmap_time_basis": true
            },
            "indexByName": {
              "hostname": 0,
              "ip": 1,
              "status": 2,
              "os": 3,
              "observed_open_ports": 4,
              "dashboard_uid": 5
            },
            "renameByName": {
              "hostname": "Hostname",
              "ip": "Current IP",
              "status": "Presence",
              "os": "Operating system",
              "observed_open_ports": "Observed open ports",
              "dashboard_uid": "Open host"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Open host"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this host's data-only dashboard",
                    "url": "/d/${__value.raw}",
                    "targetBlank": false
                  }
                ]
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      ".*": {
                        "text": "Open host →"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.width",
                "value": 145
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": true
      }
    }
  ]
}
