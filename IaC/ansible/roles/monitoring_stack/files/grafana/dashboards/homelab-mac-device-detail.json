    {
      "id": 12,
      "title": "Kernel/system identity, if available",
      "type": "table",
      "description": "Shows live Linux system facts where Node Exporter is deployed.",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_uname_info{target_name=\"$node_host\"}",
