{
  "id": null,
  "uid": "homelab-operations",
  "title": "Homelab \u2014 Operations Overview",
  "description": "Single-page operational view of availability, alerts, resource pressure, network hosts and observability health.",
  "tags": [
    "homelab",
    "operations",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
