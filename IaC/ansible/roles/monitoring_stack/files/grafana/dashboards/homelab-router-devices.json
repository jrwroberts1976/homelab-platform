{
  "id": null,
  "uid": "homelab-router-devices",
  "title": "Homelab \u2014 Router Devices",
  "description": "Authoritative MAC-keyed DHCP inventory. Baseline devices are not automatically scanned.",
  "tags": [
    "homelab",
    "network",
    "dhcp",
    "mac"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "2m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Existing Network Hosts",
      "type": "link",
      "url": "/d/homelab-network-hosts",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "title": "Linux Hosts",
      "type": "link",
      "url": "/d/homelab-linux-estate",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Known MAC Addresses",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(homelab_router_device_info) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Adapter Manufacturers Identified",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(homelab_router_device_adapter_vendor_info) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "New Devices Pending",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(homelab_router_device_info{discovery_status=\"pending\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Scan Profiles Available",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(homelab_router_device_scan_state{status=~\"complete|partial\"}) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "MAC-keyed Device Inventory",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(homelab_router_device_info * on(mac) group_left(vendor) homelab_router_device_adapter_vendor_info) or (homelab_router_device_info unless on(mac) homelab_router_device_adapter_vendor_info)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mac"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open MAC device profile",
                    "url": "/d/homelab-router-device-profile?var-mac=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "DHCP identity with network-adapter manufacturer where the MAC prefix is identifiable. Manufacturer is not necessarily the make of the complete device."
    },
    {
      "id": 6,
      "type": "table",
      "title": "LAN Sweep \u2014 All Discovered Devices",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((max by(mac,ip)(homelab_lan_presence_info) * on(mac) group_left() max by(mac)(homelab_lan_presence_observed)) * on(mac) group_left(hostname) label_replace(max by(mac,exported_target_name)(homelab_lan_presence_host_info),\"hostname\",\"$1\",\"exported_target_name\",\"(.+)\")) or ((max by(mac,ip)(homelab_lan_presence_info) * on(mac) group_left() max by(mac)(homelab_lan_presence_observed)) unless on(mac) label_replace(max by(mac,exported_target_name)(homelab_lan_presence_host_info),\"hostname\",\"$1\",\"exported_target_name\",\"(.+)\"))) and on() (time() - homelab_lan_presence_last_sweep_seconds < 1200)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mac"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open MAC device profile",
                    "url": "/d/homelab-router-device-profile?var-mac=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "MAC-keyed inventory. IP is last known; 1 means observed in the latest successful sweep, 0 means not observed. Check sweep freshness before interpreting status."
    },
    {
      "id": 7,
      "type": "stat",
      "title": "LAN Sweep \u2014 Freshness",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - homelab_lan_presence_last_sweep_seconds",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 900
              },
              {
                "color": "red",
                "value": 1200
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    }
  ]
}
