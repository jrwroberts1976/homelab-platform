              "hostname": 0,
              "ip": 1,
              "mac": 2,
              "vendor": 3,
              "kind": 4,
              "status": 5,
              "os": 6,
              "os_evidence": 7,
              "os_source": 8,
              "dns_hint": 9,
              "dns_observed": 10,
              "observed_open_ports": 11,
              "role": 12
            },
            "renameByName": {
              "hostname": "Hostname",
              "ip": "IP",
              "mac": "MAC address",
              "vendor": "Vendor",
              "kind": "Host type",
              "status": "Presence",
              "os": "Operating system",
              "os_evidence": "OS evidence",
              "os_source": "OS source",
              "dns_hint": "DNS observations",
              "dns_observed": "DNS date",
              "observed_open_ports": "Observed open ports",
              "role": "Documented role"
