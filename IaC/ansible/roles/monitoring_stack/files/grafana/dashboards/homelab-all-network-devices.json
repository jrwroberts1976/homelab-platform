{
  "id": null,
  "uid": "homelab-all-network-devices",
  "title": "Homelab — All Network Devices",
  "description": "Consolidated observed/historical LAN inventory, evidence-qualified operating systems, dated DNS hints and observed open ports. Driven by the monitoring_stack Git-managed exporter.",
  "tags": [
    "homelab",
    "network",
    "inventory",
    "operating-system",
    "ports"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Device IP",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(homelab_network_device_inventory_info, ip)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
