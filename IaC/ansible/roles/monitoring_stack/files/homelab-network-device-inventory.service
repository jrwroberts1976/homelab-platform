[Unit]
Description=Publish evidence-qualified LAN device inventory for Grafana
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/sbin/homelab-network-device-inventory
# Dashboard generation runs in its own timer after the Prometheus scrape.
Nice=10
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus/node-exporter
