[Unit]
Description=Publish evidence-qualified LAN device inventory for Grafana
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 /usr/local/sbin/homelab-network-device-inventory
# Run after publication; Grafana host files update when Prometheus has scraped the new series.
# A failed generator must never stop publication of the base network inventory.
ExecStartPost=-/usr/bin/python3 /usr/local/sbin/homelab-network-host-dashboards
Nice=10
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/prometheus/node-exporter
