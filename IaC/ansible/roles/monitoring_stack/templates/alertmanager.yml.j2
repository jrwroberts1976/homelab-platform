global:
  smtp_smarthost: "{{ monitoring_alert_smtp_smarthost }}"
  smtp_from: "{{ monitoring_alert_email_from }}"
  smtp_require_tls: false

route:
  receiver: gmail-email
  group_by:
    - alertname
    - target_name
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: gmail-email
    email_configs:
      - to: "{{ monitoring_alert_email_to }}"
        send_resolved: true
        headers:
          subject: "[homelab] {{ '{{' }} .Status {{ '}}' }}: {{ '{{' }} .CommonAnnotations.summary {{ '}}' }}"
