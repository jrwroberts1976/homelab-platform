groups:
  - name: homelab-core-connectivity
    rules:
      - alert: DNSServiceDown
        expr: probe_success{job="blackbox-dns-tcp"} == 0
        for: 2m
        labels:
          severity: critical
          service: dns
        annotations:
          summary: "DNS service unavailable on {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "TCP/53 on {{ "{{" }} $labels.instance {{ "}}" }} has failed continuously for more than 2 minutes."

      - alert: ProxmoxHTTPSDown
        expr: probe_success{job="blackbox-pve-https"} == 0
        for: 3m
        labels:
          severity: critical
          service: proxmox
        annotations:
          summary: "Proxmox web/API unavailable on {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "HTTPS/8006 on {{ "{{" }} $labels.target_name {{ "}}" }} has failed continuously for more than 3 minutes."

      - alert: CoreHostUnreachable
        expr: probe_success{job="blackbox-icmp",target_name=~"router|dns-01|dns-02|monitor-01|edge-01|PROXMOX|Proxmox-2"} == 0
        for: 3m
        labels:
          severity: critical
          service: infrastructure
        annotations:
          summary: "Core host unreachable: {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "ICMP reachability to {{ "{{" }} $labels.instance {{ "}}" }} has failed for more than 3 minutes."

      - alert: NonCoreHostUnreachable
        expr: probe_success{job="blackbox-icmp",target_name=~"docker-01|media-01"} == 0
        for: 5m
        labels:
          severity: warning
          service: infrastructure
        annotations:
          summary: "Host unreachable: {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "ICMP reachability to {{ "{{" }} $labels.instance {{ "}}" }} has failed for more than 5 minutes."

      - alert: NodeExporterDown
        expr: up{job="node-exporter"} == 0
        for: 3m
        labels:
          severity: critical
          service: host-metrics
        annotations:
          summary: "Host metrics unavailable: {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "Prometheus cannot scrape node_exporter on {{ "{{" }} $labels.instance {{ "}}" }} for more than 3 minutes."

      - alert: MonitoringTargetDown
        expr: up{job=~"prometheus|blackbox-exporter|loki"} == 0
        for: 2m
        labels:
          severity: critical
          service: monitoring
        annotations:
          summary: "Monitoring component unavailable: {{ "{{" }} $labels.job {{ "}}" }}"
          description: "Prometheus reports {{ "{{" }} $labels.instance {{ "}}" }} in job {{ "{{" }} $labels.job {{ "}}" }} down for more than 2 minutes."

  - name: homelab-observability-pipeline
    rules:
      - alert: AlloyServiceDown
        expr: node_systemd_unit_state{job="node-exporter",name="alloy.service",state="active",target_name=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"} == 0
        for: 3m
        labels:
          severity: critical
          service: observability-pipeline
        annotations:
          summary: "Alloy service stopped on {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "The host is still exporting node metrics, but alloy.service has not been active for more than 3 minutes."

      - alert: AlloyHealthMetricsUnavailable
        expr: homelab_alloy_health_scrape_success{job="node-exporter",target_name=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"} == 0
        for: 3m
        labels:
          severity: warning
          service: observability-pipeline
        annotations:
          summary: "Alloy internal metrics unavailable on {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "The local health collector cannot read Alloy's loopback metrics endpoint."

      - alert: AlloyHealthCollectorStale
        expr: time() - homelab_alloy_health_collector_timestamp_seconds{job="node-exporter",target_name=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"} > 180
        for: 3m
        labels:
          severity: warning
          service: observability-pipeline
        annotations:
          summary: "Alloy health collector stale on {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "The Alloy textfile health collector has not refreshed for more than 3 minutes."

      - alert: AlloyWriteRetries
        expr: increase(homelab_alloy_write_batch_retries_total{job="node-exporter",target_name=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"}[10m]) > 0
        for: 2m
        labels:
          severity: warning
          service: observability-pipeline
        annotations:
          summary: "Alloy is retrying Loki writes from {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "At least one Loki write batch retry has occurred during the last 10 minutes."

      - alert: AlloyWriteDroppedEntries
        expr: increase(homelab_alloy_write_dropped_entries_total{job="node-exporter",target_name=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"}[10m]) > 0
        for: 1m
        labels:
          severity: critical
          service: observability-pipeline
        annotations:
          summary: "Alloy dropped log entries on {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "Alloy reports log entries dropped before successful Loki ingestion during the last 10 minutes."

      - alert: LokiHeartbeatCollectorStale
        expr: time() - homelab_loki_heartbeat_collector_timestamp_seconds{job="node-exporter",target_name="monitor-01"} > 180
        for: 3m
        labels:
          severity: warning
          service: observability-pipeline
        annotations:
          summary: "Loki heartbeat verifier is stale"
          description: "monitor-01 has not refreshed the Loki heartbeat verification metrics for more than 3 minutes."

      - alert: LokiHeartbeatQueryFailed
        expr: homelab_loki_heartbeat_query_success{job="node-exporter",target_name="monitor-01",source_host=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"} == 0
        for: 3m
        labels:
          severity: critical
          service: observability-pipeline
        annotations:
          summary: "Loki heartbeat query failed for {{ "{{" }} $labels.source_host {{ "}}" }}"
          description: "monitor-01 cannot successfully query Loki for the host's observability heartbeat."

      - alert: AlloyTelemetrySilent
        expr: |
          (
            homelab_loki_heartbeat_present{
              job="node-exporter",
              target_name="monitor-01",
              source_host=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"
            } == 0
            or
            homelab_loki_heartbeat_age_seconds{
              job="node-exporter",
              target_name="monitor-01",
              source_host=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"
            } > {{ monitoring_alloy_heartbeat_stale_seconds }}
          )
          and on(source_host)
          (
            homelab_loki_heartbeat_query_success{
              job="node-exporter",
              target_name="monitor-01",
              source_host=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"
            } == 1
          )
          and on(source_host)
          label_replace(
            node_systemd_unit_state{
              job="node-exporter",
              name="alloy.service",
              state="active",
              target_name=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"
            } == 1,
            "source_host",
            "$1",
            "target_name",
            "(.*)"
          )
          and on(source_host)
          label_replace(
            probe_success{
              job="blackbox-icmp",
              target_name=~"{{ monitoring_alloy_heartbeat_hosts | join('|') }}"
            } == 1,
            "source_host",
            "$1",
            "target_name",
            "(.*)"
          )
        for: 3m
        labels:
          severity: critical
          service: observability-pipeline
        annotations:
          summary: "Telemetry silent from {{ "{{" }} $labels.source_host {{ "}}" }}"
          description: "The host is reachable and Alloy is active, but its journal heartbeat has not arrived in Loki within the expected window."

  - name: homelab-host-capacity
    rules:
      - alert: NodeFilesystemSpaceLow
        expr: |
          (
            node_filesystem_avail_bytes{
              job="node-exporter",
              fstype!~"tmpfs|devtmpfs|overlay|squashfs|nsfs|fuse.lxcfs",
              mountpoint!~"/run($|/)|/var/lib/docker/.+"
            }
            /
            node_filesystem_size_bytes{
              job="node-exporter",
              fstype!~"tmpfs|devtmpfs|overlay|squashfs|nsfs|fuse.lxcfs",
              mountpoint!~"/run($|/)|/var/lib/docker/.+"
            }
          ) * 100 < 10
        for: 10m
        labels:
          severity: warning
          service: storage
        annotations:
          summary: "Low disk space on {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "Filesystem {{ "{{" }} $labels.mountpoint {{ "}}" }} on {{ "{{" }} $labels.target_name {{ "}}" }} has less than 10% space available."

      - alert: NodeMemoryHigh
        expr: |
          100 * (
            1 -
            (
              node_memory_MemAvailable_bytes{job="node-exporter"}
              /
              node_memory_MemTotal_bytes{job="node-exporter"}
            )
          ) > 90
        for: 15m
        labels:
          severity: warning
          service: memory
        annotations:
          summary: "High memory use on {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "Memory utilisation on {{ "{{" }} $labels.target_name {{ "}}" }} has remained above 90% for 15 minutes."

      - alert: NodeCPUHigh
        expr: |
          100 * (
            1 -
            avg by (instance, target_name) (
              rate(node_cpu_seconds_total{job="node-exporter",mode="idle"}[5m])
            )
          ) > 90
        for: 15m
        labels:
          severity: warning
          service: cpu
        annotations:
          summary: "High CPU use on {{ "{{" }} $labels.target_name {{ "}}" }}"
          description: "CPU utilisation on {{ "{{" }} $labels.target_name {{ "}}" }} has remained above 90% for 15 minutes."
