apiVersion: 1

providers:
  - name: Homelab
    orgId: 1
    folder: Homelab
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /etc/grafana/provisioning/dashboards/homelab
      foldersFromFilesStructure: false

  - name: Homelab Production
    orgId: 1
    folder: Production Dashboards
    folderUid: homelab-production
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /etc/grafana/provisioning/dashboards/production
      foldersFromFilesStructure: false

  # Files generated from the stable device MAC, using a root-level folder.
  - name: Network Hosts
    orgId: 1
    folder: Network Hosts
    folderUid: homelab-generated-network-hosts
    type: file
    disableDeletion: false
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /etc/grafana/provisioning/dashboards/network-hosts
      foldersFromFilesStructure: false
