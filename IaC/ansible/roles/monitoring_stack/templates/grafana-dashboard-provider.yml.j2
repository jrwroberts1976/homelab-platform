apiVersion: 1

providers:
  - name: Homelab
    orgId: 1
    folder: Homelab
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /etc/grafana/provisioning/dashboards/homelab
      foldersFromFilesStructure: false

  - name: Homelab Production
    orgId: 1
    folder: Production Dashboards
    folderUid: homelab-production
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /etc/grafana/provisioning/dashboards/production
      foldersFromFilesStructure: false

  # Isolated new router-01 DHCP device pages; never resurrect old Network Hosts.
  - name: Router DHCP Devices
    orgId: 1
    folder: Router DHCP Devices
    folderUid: router-dhcp-devices
    type: file
    disableDeletion: true
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: /etc/grafana/provisioning/dashboards/router-dhcp-devices
      foldersFromFilesStructure: false
