# Managed by homelab-platform IaC.
# qBittorrent is left listening on HTTP while this HTTPS stage is verified.
# No HTTP redirect listener is installed here.
server {
    listen 443 ssl;
    server_name {{ qbittorrent_https_fqdn }};

    ssl_certificate {{ qbittorrent_https_certificate_fullchain }};
    ssl_certificate_key {{ qbittorrent_https_certificate_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    location / {
        proxy_pass http://{{ qbittorrent_https_backend }}:{{ qbittorrent_https_backend_port }};
        proxy_http_version 1.1;

        # qBittorrent's documented Nginx reverse-proxy header policy.
        # Keep WebUI host-header validation and CSRF protection enabled.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Backend's HTTP-only session cookie must be Secure in the HTTPS UI.
        proxy_cookie_flags ~.* secure;

        client_max_body_size 16m;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
