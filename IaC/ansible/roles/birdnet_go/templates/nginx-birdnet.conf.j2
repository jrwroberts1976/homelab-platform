server {
    listen 80;
    listen [::]:80;

    server_name {{ birdnet_go_fqdn }};

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;

    server_name {{ birdnet_go_fqdn }};

    ssl_certificate {{ birdnet_go_certificate_fullchain }};
    ssl_certificate_key {{ birdnet_go_certificate_private_key }};

    ssl_protocols TLSv1.2 TLSv1.3;


    location / {
        proxy_pass http://127.0.0.1:{{ birdnet_go_web_port }};

        # CSRF cookie arrives from the HTTP backend without Secure.
        # Only add Secure; do not force HttpOnly on a JavaScript-readable token.
        proxy_cookie_flags csrf secure;

        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
