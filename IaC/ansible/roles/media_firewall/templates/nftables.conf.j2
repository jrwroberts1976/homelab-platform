#!/usr/sbin/nft -f
# Managed by homelab-platform/IaC. Do not edit by hand.

flush ruleset

table inet media_filter {
  chain input {
    type filter hook input priority filter; policy drop;

    ct state invalid drop
{% if media_firewall_icmp_timestamp_drop_enabled | bool %}
    # Reject only IPv4 ICMP timestamp requests (type 13).
    # Must precede established/related and the later broad IPv4 ICMP accept.
    icmp type timestamp-request drop comment "Block ICMPv4 timestamp requests"
{% endif %}
    ct state established,related accept

    iifname "lo" accept

    # Preserve IPv4/IPv6 network diagnostics and IPv6 neighbour discovery.
    ip protocol icmp accept
    meta l4proto ipv6-icmp accept

    # DHCP renewal if media-01 is using the router reservation.
    ip saddr {{ media_firewall_dhcp_server_ipv4 }} udp sport 67 udp dport 68 accept

    # Administration and media upload are LAN-only.
    ip saddr {{ media_firewall_lan_subnet }} tcp dport 22 accept comment "LAN SSH"
    ip saddr {{ media_firewall_lan_subnet }} tcp dport 445 accept comment "LAN SMB"
{% if media_firewall_qbittorrent_https_lan_enabled | bool %}
    ip saddr {{ media_firewall_lan_subnet }} tcp dport 443 accept comment "LAN qBittorrent HTTPS"
{% endif %}
{% if media_firewall_qbittorrent_http_lan_enabled | bool %}
    ip saddr {{ media_firewall_lan_subnet }} tcp dport 8081 accept comment "LAN qBittorrent WebUI"
{% endif %}
    ip saddr {{ media_firewall_lan_subnet }} udp dport 1900 accept comment "LAN Kodi SSDP/DLNA"
    ip saddr {{ media_firewall_lan_subnet }} tcp dport 1255 accept comment "LAN Kodi UPnP server"
    ip saddr {{ media_firewall_lan_subnet }} tcp dport 1879 accept comment "LAN Kodi UPnP server"

    # Proxmox backup NFS is reachable only by the two hypervisors.
{% for client in media_firewall_backup_nfs_clients %}
    ip saddr {{ client }} tcp dport 2049 accept comment "Proxmox backup NFS"
{% endfor %}

    # Prometheus node_exporter is readable only by monitor-01.
    ip saddr {{ media_firewall_monitor_ipv4 }} tcp dport 9100 accept comment "monitor-01 node_exporter"
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
