# Copy to terraform.tfvars locally. terraform.tfvars is intentionally ignored by Git.
#
# Values below remain examples until copied to a local terraform.tfvars.
# `100` was the live `pvesh get /cluster/nextid` result on 7 September 2026; re-check immediately before apply.
# The IPv4 address is still only a candidate and must be proven unused/reserved.

vm_id     = 100
ipv4_cidr = "192.168.2.49/24"

ssh_public_keys = [
  "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"
]

# Do not put the API token here.
# Supply it in the shell:
# export TF_VAR_proxmox_api_token='user@realm!token=secret'
