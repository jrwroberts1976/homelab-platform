# Copy to terraform.tfvars locally. terraform.tfvars is intentionally ignored by Git.
#
# dns-02 identity is now defined in variables.tf:
#   CT ID: 100
#   IPv4:  192.168.2.50/24
#
# Re-check CT ID 100 immediately before the first apply. The address
# 192.168.2.50 has been checked and approved for dns-02.

# Override only if the approved design changes:
# vm_id     = 100
# ipv4_cidr = "192.168.2.50/24"

ssh_public_keys = [
  "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"
]

# Do not put the API token here.
# Supply it in the shell:
# export TF_VAR_proxmox_api_token='user@realm!token=secret'
